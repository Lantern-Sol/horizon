{%- assign block_index = section.blocks | find_index: 'id', block.id -%}

{% capture children %}
  {%- liquid
    assign desktop_image = block.settings.image
    assign mobile_image = block.settings.mobile_image
    if mobile_image == blank
      assign mobile_image = desktop_image
    endif

    assign loading = 'lazy'
    assign fetchpriority = 'low'
    if block_index == 0 and section.index <= 2
      assign loading = 'eager'
      assign fetchpriority = 'high'
    endif

    assign mobile_widths = '416, 600, 800, 1200'
    assign mobile_widths_array = mobile_widths | split: ', '
  -%}

  <div
    class="hero-slide"
    style="--hero-arrow-icon: url('{{ 'icon-arrow-top-right.svg' | asset_url }}')"
  >
    <div class="hero-slide__media-container">
      {%- if desktop_image != blank -%}
        <picture class="hero-slide__media">
          <source
            media="(max-width: 749px)"
            srcset="
              {%- for mobile_width in mobile_widths_array -%}
                {{ mobile_image | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            "
            sizes="100vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
          {{
            desktop_image
            | image_url: width: 3840
            | image_tag:
              width: desktop_image.width,
              height: desktop_image.height,
              alt: desktop_image.alt,
              class: 'hero-slide__media',
              sizes: '100vw',
              widths: '832, 1200, 1600, 1920, 2560',
              loading: loading,
              fetchpriority: fetchpriority
          }}
        </picture>
      {%- else -%}
        {%- comment -%} Temporary placeholder art until real assets are picked in the theme editor. {%- endcomment -%}
        <picture class="hero-slide__media">
          <source media="(max-width: 749px)" srcset="{{ 'hero-slide-temp-mobile.png' | asset_url }}">
          <img
            src="{{ 'hero-slide-temp.png' | asset_url }}"
            alt=""
            class="hero-slide__media"
            width="1024"
            height="683"
            loading="{{ loading }}"
            fetchpriority="{{ fetchpriority }}"
          >
        </picture>
      {%- endif -%}
      {%- if block.settings.show_overlay -%}
        <div class="hero-slide__overlay"></div>
      {%- endif -%}
    </div>

    <div
      class="
        hero-slide__content
        group-block-content
        layout-panel-flex
        layout-panel-flex--{{ block.settings.content_direction }}
        {% if block.settings.vertical_on_mobile %}mobile-column{% endif %}
      "
      style="{% render 'layout-panel-style', settings: block.settings %}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
{% endcapture %}

{% render 'slideshow-slide',
  index: block_index,
  children: children,
  attributes: block.shopify_attributes,
  navigate_to_slide: true
%}

{% stylesheet %}
  .hero-slide {
    position: relative;
    display: flex;
    height: var(--hero-slide-height-mobile);
    padding: var(--hero-slide-padding-mobile);
    overflow: hidden;
    border-radius: var(--hero-slide-radius-mobile);

    @media screen and (min-width: 750px) {
      height: var(--hero-slide-height);
      padding: var(--hero-slide-padding);
      border-radius: var(--hero-slide-radius);
    }
  }

  .hero-slide__media-container {
    position: absolute;
    inset: 0;
  }

  .hero-slide__media-container picture.hero-slide__media {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-slide__media-container img.hero-slide__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  /* Teal brand gradient pulled from the Figma design (Section/Hero) */
  .hero-slide__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(79.54deg, rgb(66 168 153 / 20%) 18.44%, rgb(59 169 153 / 6%) 40.93%),
      linear-gradient(181.91deg, rgb(6 76 77 / 0%) 8.89%, var(--color-teal-800, #064c4d) 56.76%);

    @media screen and (min-width: 750px) {
      background-image:
        linear-gradient(59.6deg, rgb(66 168 153 / 20%) 18.44%, rgb(59 169 153 / 6%) 40.93%),
        linear-gradient(180deg, rgb(6 76 77 / 0%) 34.62%, var(--color-teal-800, #064c4d) 96.67%);
    }
  }

  .hero-slide__content {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    color: rgb(255 255 255);
  }

  /*
   * Hero button treatment — the Figma pill (Button/Primary/LG/outline).
   * Applies on top of the theme button block so merchants keep using the
   * standard button block inside hero slides.
   */
  .hero-slide .hero-slide__content a:is(.button, .button-secondary, .button-custom) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 28px;
    border-radius: 80px;
    font-size: 20px;
    font-weight: 600;
    line-height: normal;
    letter-spacing: 0.02em;
  }

  .hero-slide .hero-slide__content a:is(.button, .button-secondary, .button-custom)::after {
    content: '';
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    background-color: currentcolor;
    mask: var(--hero-arrow-icon) center / 24px 24px no-repeat;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero slide",
  "tag": null,
  "blocks": [
    {
      "type": "group"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "icon"
    },
    {
      "type": "spacer"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "A temporary placeholder image is shown until an image is picked."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show teal gradient overlay",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "flex-end",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-end",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Hero slide"
    }
  ]
}
{% endschema %}
