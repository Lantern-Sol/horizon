{% liquid
  assign product = closest.product
  assign has_applied_colour_filter = false
  assign filters_to_check = collection.filters | default: search.filters

  for filter in filters_to_check
    if filter.type == 'list' and filter.param_name contains 'color' and filter.active_values.size > 0
      assign has_applied_colour_filter = true
      break
    endif
  endfor

  assign hover_tagline = product.metafields.custom.card_hover_tagline.value
  assign hover_background = product.metafields.custom.card_hover_background.value
  assign hover_icon = product.metafields.custom.card_hover_icon.value
  assign show_hover_panel = false
  if block.settings.show_hover_label and hover_tagline != blank
    assign show_hover_panel = true
  endif
%}

{% capture children %}
  {% unless product == blank %}
    {%- if show_hover_panel -%}
      <div
        class="card-hover-panel"
        style="{% if hover_background != blank %}--card-hover-bg: {{ hover_background }};{% endif %}"
        aria-hidden="true"
      >
        {%- if hover_icon != blank -%}
          <div class="card-hover-panel__icon">
            {{ hover_icon | image_url: width: 80 | image_tag: loading: 'lazy', width: 40, height: 40, alt: '' }}
          </div>
        {%- endif -%}
        <p class="card-hover-panel__tagline">{{ hover_tagline }}</p>
      </div>
    {%- endif -%}
    <div
      class="product-badges product-badges--{{ settings.badge_position }}"
      style="
        --badge-border-radius: {{ settings.badge_corner_radius }}px;
        --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
      "
    >
      {%- if product.available == false or product.compare_at_price > product.price -%}
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-custom-badge-sold-out{% elsif product.compare_at_price > product.price %} color-custom-badge-sale{% endif %}
          "
        >
          {%- if product.available == false -%}
            {{ 'content.product_badge_sold_out' | t }}
          {%- elsif product.compare_at_price > product.price -%}
            {{ 'content.product_badge_sale' | t }}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- liquid
      assign show_quick_add = false
      if block.settings.show_overlay_quick_add and settings.quick_add
        assign show_quick_add = true
      elsif block.settings.show_overlay_quick_add and settings.mobile_quick_add
        assign show_quick_add = true
      endif

      assign show_view_product = false
      if block.settings.show_view_product and product.selected_or_first_available_variant.url != blank
        assign show_view_product = true
      endif
    -%}
    {%- if show_view_product -%}
      {% comment %}
        Quick-add normally pins itself to the bottom-right of the media. When a second action is
        present the two share a centered row instead, laid out by .card-media-actions below.
      {% endcomment %}
      <div
        class="card-media-actions"
        style="--card-media-actions-plus: url('{{ 'icon-plus.svg' | asset_url }}'); --card-media-actions-arrow: url('{{ 'icon-arrow-top-right.svg' | asset_url }}');"
      >
        {%- if show_quick_add -%}
          {% comment %} show_icon: false — the design's trailing glyph is a plus, not the cart icon. {% endcomment %}
          {% render 'quick-add',
            product: product,
            section_id: section.id,
            show_icon: false,
            add_to_cart_text: block.settings.add_to_cart_label
          %}
        {%- endif -%}
        <a
          class="button-secondary card-media-actions__view"
          href="{{ product.selected_or_first_available_variant.url }}"
        >
          {{ block.settings.view_product_label }}
        </a>
      </div>
    {%- elsif show_quick_add -%}
      {% render 'quick-add', product: product, section_id: section.id %}
    {%- endif -%}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% # Title and price for the zoomed out grid view %}
<div class="product-grid-view-zoom-out--details">
  {% if product == blank %}
    <h3 class="h4">{{ 'content.product_card_placeholder' | t }}</h3>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
  {% endif %}
</div>

{% render 'product-badges-styles' %}

{% stylesheet %}
  .card-hover-panel {
    position: absolute;
    inset: 0;
    z-index: calc(var(--layer-flat) - 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--padding-md);
    padding: var(--padding-lg);
    background: var(--card-hover-bg, var(--color-foreground));
    color: var(--color-background);
    text-align: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .product-card:hover .card-hover-panel,
  .product-card:focus-within .card-hover-panel {
    opacity: 1;
  }

  .card-hover-panel__icon img {
    width: 1.5625rem;
    height: auto;
    display: block;
  }

  .card-hover-panel__tagline {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--xl);
    line-height: normal;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    max-width: 16.25rem;

    @media only screen and (max-width: 749px) {
      font-size: var(--font-size--md);
    }
  }

  @media (hover: none) {
    .card-hover-panel {
      display: none;
    }
  }
  slideshow-slide.product-media-container.product-media-container--image {
    background-color: var(--color-background, transparent);
  }

  /* Figma anchors the action row to the bottom of the media with 32px padding. */
  .card-media-actions {
    position: absolute;
    inset-inline: 0;
    bottom: var(--padding-4xl);
    z-index: var(--layer-raised);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    padding-inline: var(--padding-4xl);
    pointer-events: none;
  }

  /* Release quick-add from its bottom-right anchor so both actions share the row.
     Mirrors blocks/product-quick-add.liquid, minus its full-width stretch. */
  /* quick-add's wrappers are custom elements that default to `display: inline`, so in a
     flex row they collapse to 0 width and the button overflows on top of the sibling
     action instead of sitting beside it. Make the whole chain shrink-to-fit. */
  .card-media-actions .quick-add,
  .card-media-actions .quick-add__product-form-component,
  .card-media-actions .quick-add__product-form-component .shopify-product-form {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: auto;
    height: auto;
  }

  /* The form declares `container-type: inline-size`, which contains its inline axis so its
     content cannot size it — fine when it fills an `inset: 0` parent, but it collapses to 0
     in this shrink-to-fit row. That also made base.css's `@container (max-width: 70px)`
     rule (nearest container = this form) hide the button whenever the gallery was hovered. */
  .card-media-actions .quick-add__product-form-component .shopify-product-form {
    container-type: normal;
  }

  .card-media-actions .quick-add {
    position: static;
    inset: auto;
    pointer-events: auto;
  }

  /* Shared pill geometry = Figma UI/Button/Small. Deliberately sets no `display`:
     the quick-add button's own `--quick-add-display` is what keeps it desktop-only. */
  .card-media-actions .quick-add__button.quick-add__button,
  .card-media-actions__view.card-media-actions__view {
    height: auto;
    min-height: 0;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding-block: 10px;
    padding-inline: 20px;
    border: none;
    border-radius: 80px;
    font-size: var(--font-button-sm--size);
    font-weight: var(--font-button--weight);
    line-height: var(--font-button--line-height);
    letter-spacing: var(--font-button--letter-spacing);
    white-space: nowrap;
  }

  /* Primary action: solid fill, and the label stays visible. base.css collapses it to
     a 0fr grid track until the button itself is hovered, which the design does not do. */
  .card-media-actions .quick-add__button.quick-add__button {
    position: static;
    right: auto;
    bottom: auto;
    background: var(--button-background-color);
    color: var(--button-color);
    backdrop-filter: none;
  }

  .card-media-actions .quick-add__button .add-to-cart-text {
    background: transparent;
    height: auto;
    border-radius: 0;
  }

  .card-media-actions .quick-add__button .add-to-cart-text__content {
    grid-template-columns: 1fr;
  }

  .card-media-actions .quick-add__button .add-to-cart-text__content span span {
    opacity: 1;
    translate: 0 0;
    filter: blur(0);
    padding-right: 0;
  }

  .card-media-actions .quick-add__button.quick-add__button:is(:hover, :focus-visible) {
    scale: 1;
  }

  /* Trailing glyphs: plus on the primary, arrow on the secondary. */
  .card-media-actions .quick-add__button.quick-add__button::after,
  .card-media-actions__view.card-media-actions__view::after {
    content: '';
    flex-shrink: 0;
    background-color: currentcolor;
  }

  /* Both glyphs sit in a small box inside a much larger viewBox (the arrow's path spans only
     7..17 of 24, the plus's 2.75..11.25 of 14). `contain` would scale the whole canvas down and
     render a hairline, so instead the mask keeps its natural size and the box crops to it —
     the same technique snippets/button-custom-styles.liquid uses for its arrow. */
  .card-media-actions .quick-add__button.quick-add__button::after {
    width: 10px;
    height: 10px;
    mask: var(--card-media-actions-plus) center / 14px 14px no-repeat;
  }

  .card-media-actions__view.card-media-actions__view::after {
    width: 10px;
    height: 10px;
    mask: var(--card-media-actions-arrow) center / 24px 24px no-repeat;
  }

  /* The mobile frames show no overlay at all, so the secondary action is desktop-only —
     the same breakpoint at which quick-add reveals itself. Without this it was the only
     button rendering below 750px. */
  .card-media-actions__view.card-media-actions__view {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .card-media-actions__view.card-media-actions__view {
      display: inline-flex;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--hover-transition-duration) var(--hover-transition-timing);
    }

    product-card:is(:hover, :focus-within) .card-media-actions__view.card-media-actions__view {
      opacity: 1;
      pointer-events: all;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "checkbox",
      "id": "show_hover_label",
      "label": "Show hover label (category metafield)",
      "info": "On hover, replaces the image with the product's card_hover_background, card_hover_icon, and card_hover_tagline custom metafields. Requires these metafields to be set on the product.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_overlay_quick_add",
      "label": "Show quick-add over media",
      "info": "Turn off if you're using the separate Quick add block elsewhere on the card. Requires the theme-wide Quick add setting to be enabled.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_product",
      "label": "Show view product link over media",
      "info": "Adds a secondary link beside the quick-add button. Both are revealed together on hover and share a centered row at the bottom of the media.",
      "default": false
    },
    {
      "type": "text",
      "id": "view_product_label",
      "label": "View product label",
      "default": "View Product",
      "visible_if": "{{ block.settings.show_view_product }}"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "info": "Leave blank to use the theme's default label.",
      "default": "Add to Cart",
      "visible_if": "{{ block.settings.show_view_product }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
