{%- liquid
  assign categories = section.blocks | where: 'type', 'category'
  assign application_options = section.settings.application_options | default: 'All Applications,Car Audio,Automotive Restoration,Home/Architectural,International'
  assign application_list = application_options | split: ','
-%}

{{ 'dealer-locator-hero.css' | asset_url | stylesheet_tag }}

<section
  id="dl-hero-{{ section.id }}"
  class="dl-hero"
  data-dl-hero
  data-dl-scope="{{ section.settings.scope | default: 'default' }}"
>
  <div class="dl-hero__bg" aria-hidden="true">
    <svg class="dl-hero__bg-map" viewBox="0 0 1440 960" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="#ffffff" opacity="0.06">
        <path d="M120 100 q40 -30 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" fill="none" stroke="#ffffff" stroke-width="1.5" />
        <path d="M80 220 q40 -30 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" fill="none" stroke="#ffffff" stroke-width="1.5" />
        <path d="M160 360 q40 -30 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" fill="none" stroke="#ffffff" stroke-width="1.5" />
        <path d="M40 520 q40 -30 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" fill="none" stroke="#ffffff" stroke-width="1.5" />
        <path d="M200 680 q40 -30 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" fill="none" stroke="#ffffff" stroke-width="1.5" />
        <path d="M120 820 q40 -30 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0" fill="none" stroke="#ffffff" stroke-width="1.5" />
      </g>
      <g fill="#ffffff" opacity="0.05">
        <circle cx="120" cy="180" r="38" />
        <circle cx="320" cy="240" r="60" />
        <circle cx="540" cy="160" r="48" />
        <circle cx="780" cy="280" r="72" />
        <circle cx="960" cy="180" r="56" />
        <circle cx="1180" cy="240" r="44" />
        <circle cx="1340" cy="160" r="40" />
        <circle cx="200" cy="500" r="64" />
        <circle cx="420" cy="540" r="52" />
        <circle cx="640" cy="480" r="60" />
        <circle cx="880" cy="540" r="68" />
        <circle cx="1100" cy="480" r="48" />
        <circle cx="1320" cy="540" r="44" />
        <circle cx="160" cy="780" r="56" />
        <circle cx="380" cy="820" r="50" />
        <circle cx="600" cy="760" r="64" />
        <circle cx="820" cy="820" r="58" />
        <circle cx="1040" cy="760" r="52" />
        <circle cx="1260" cy="820" r="48" />
      </g>
    </svg>
  </div>

  <div class="dl-hero__inner">
    <h1 class="dl-hero__heading">
      <span class="dl-hero__heading-line">{{ section.settings.heading_line_1 }}</span>
      <span class="dl-hero__heading-line dl-hero__heading-line--accent">{{ section.settings.heading_line_2 }}</span>
    </h1>

    {%- if section.settings.subtitle != blank -%}
      <p class="dl-hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <form
      class="dl-hero__search"
      role="search"
      data-dl-search-form
      onsubmit="return false;"
    >
      <div class="dl-hero__search-inner">
        <div class="dl-hero__field">
          <span class="dl-hero__field-icon" aria-hidden="true">
            <svg viewBox="0 0 16 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 0C3.589 0 0 3.589 0 8C0 13.5 8 20 8 20C8 20 16 13.5 16 8C16 3.589 12.411 0 8 0ZM8 11C6.343 11 5 9.657 5 8C5 6.343 6.343 5 8 5C9.657 5 11 6.343 11 8C11 9.657 9.657 11 8 11Z" fill="#09274C"/>
            </svg>
          </span>
          <input
            type="search"
            class="dl-hero__input"
            data-dl-zip-input
            placeholder="{{ section.settings.zip_placeholder | escape }}"
            aria-label="{{ section.settings.zip_placeholder | escape }}"
            autocomplete="postal-code"
          >
        </div>

        <div class="dl-hero__field dl-hero__field--select">
          <span class="dl-hero__field-icon" aria-hidden="true">
            <svg viewBox="0 0 19 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.5 1C5.358 1 2 4.358 2 8.5C2 13.5 9.5 19 9.5 19C9.5 19 17 13.5 17 8.5C17 4.358 13.642 1 9.5 1Z" stroke="#09274C" stroke-width="1.6"/>
              <circle cx="9.5" cy="8.5" r="2.5" stroke="#09274C" stroke-width="1.6"/>
            </svg>
          </span>
          <select class="dl-hero__select" data-dl-application-select aria-label="{{ section.settings.application_label | escape }}">
            {%- for opt in application_list -%}
              {%- assign trimmed = opt | strip -%}
              <option value="{{ trimmed | escape }}">{{ trimmed }}</option>
            {%- endfor -%}
          </select>
          <span class="dl-hero__select-caret" aria-hidden="true">
            <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1L5 5L9 1" stroke="#09274C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>

        <button type="submit" class="dl-hero__submit" data-dl-submit>
          <span class="dl-hero__submit-label dl-hero__submit-label--desktop">{{ section.settings.submit_label }}</span>
          <span class="dl-hero__submit-label dl-hero__submit-label--mobile">Send Message</span>
        </button>
      </div>
    </form>

    {%- if categories.size > 0 -%}
      <div class="dl-hero__categories" role="group" aria-label="Dealer categories">
        {%- for block in categories -%}
          {%- assign icon_type = block.settings.icon_type | default: 'car' -%}
          <button
            type="button"
            class="dl-hero__category"
            data-dl-category
            data-dl-value="{{ block.settings.value | escape }}"
            {{ block.shopify_attributes }}
          >
            <span class="dl-hero__category-icon" aria-hidden="true">
              {%- case icon_type -%}
                {%- when 'car' -%}
                  <svg viewBox="0 0 24 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 12L4.5 7.5C4.8 6.6 5.6 6 6.5 6H17.5C18.4 6 19.2 6.6 19.5 7.5L21 12V17C21 17.55 20.55 18 20 18H19C18.45 18 18 17.55 18 17V16H6V17C6 17.55 5.55 18 5 18H4C3.45 18 3 17.55 3 17V12Z" stroke="#FFFFFF" stroke-width="1.6" stroke-linejoin="round"/>
                    <circle cx="7" cy="13" r="1.5" fill="#FFFFFF"/>
                    <circle cx="17" cy="13" r="1.5" fill="#FFFFFF"/>
                  </svg>
                {%- when 'wrench' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14.7 6.3a4 4 0 0 0-5 5L4 17l3 3 5.7-5.7a4 4 0 0 0 5-5l-2.4 2.4-2.6-2.6 2.4-2.4a4 4 0 0 0-.4-0.4Z" stroke="#FFFFFF" stroke-width="1.6" stroke-linejoin="round"/>
                  </svg>
                {%- when 'home' -%}
                  <svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 11L11 3L19 11V19C19 19.55 18.55 20 18 20H14V14H8V20H4C3.45 20 3 19.55 3 19V11Z" stroke="#FFFFFF" stroke-width="1.6" stroke-linejoin="round"/>
                  </svg>
                {%- when 'globe' -%}
                  <svg viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12.5" cy="12.5" r="9.5" stroke="#FFFFFF" stroke-width="1.6"/>
                    <path d="M3 12.5h19M12.5 3a14 14 0 0 1 0 19M12.5 3a14 14 0 0 0 0 19" stroke="#FFFFFF" stroke-width="1.6"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="9" stroke="#FFFFFF" stroke-width="1.6" fill="none"/>
                  </svg>
              {%- endcase -%}
            </span>
            <span class="dl-hero__category-label">{{ block.settings.label }}</span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('dl-hero-{{ section.id }}');
    if (!root) return;
    const scope = root.dataset.dlScope || 'default';
    const form = root.querySelector('[data-dl-search-form]');
    const zip = root.querySelector('[data-dl-zip-input]');
    const sel = root.querySelector('[data-dl-application-select]');
    const submit = root.querySelector('[data-dl-submit]');

    const broadcast = () => {
      document.dispatchEvent(new CustomEvent('dl:search-change', {
        detail: {
          scope,
          query: (zip && zip.value || '').trim(),
          application: (sel && sel.value || 'All Applications').trim()
        }
      }));
    };

    if (submit) submit.addEventListener('click', broadcast);
    if (form) form.addEventListener('submit', broadcast);
    if (zip) zip.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); broadcast(); } });
    if (sel) sel.addEventListener('change', broadcast);

    root.querySelectorAll('[data-dl-category]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.dataset.dlValue || '';
        if (sel) {
          const match = Array.from(sel.options).find(o => o.value === value);
          sel.value = match ? value : 'All Applications';
        }
        root.querySelectorAll('[data-dl-category]').forEach(b => b.classList.toggle('is-active', b === btn));
        broadcast();
        document.getElementById('dl-results-anchor')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Dealer locator hero",
  "class": "section-wrapper dealer-locator-hero-wrapper",
  "settings": [
    { "type": "text", "id": "scope", "label": "Scope ID", "default": "default" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "FIND A DYNAMAT" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2 (accent)", "default": "DEALER NEAR YOU" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "3,000+ locations across the US and 30+ countries worldwide. Professional installation for ultimate acoustic performance." },
    { "type": "text", "id": "zip_placeholder", "label": "Zip placeholder", "default": "Enter Zip or City" },
    { "type": "text", "id": "application_label", "label": "Application aria label", "default": "Application" },
    { "type": "text", "id": "application_options", "label": "Application options (comma separated)", "default": "All Applications,Car Audio,Automotive Restoration,Home/Architectural,International" },
    { "type": "text", "id": "submit_label", "label": "Submit label (desktop)", "default": "Find Dealership" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "CAR AUDIO" },
        { "type": "text", "id": "value", "label": "Value (matches application)", "default": "Car Audio" },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "car", "label": "Car" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "home", "label": "Home" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "car"
        }
      ]
    }
  ],
  "presets": [{ "name": "Dealer locator hero" }]
}
{% endschema %}
