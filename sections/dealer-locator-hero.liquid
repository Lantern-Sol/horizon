{%- liquid
  assign categories = section.blocks | where: 'type', 'category'
  assign radius_options = section.settings.radius_options | default: 'All Applications,Car Audio,Automotive Restoration,Home/Architectural,International'
  assign radius_list = radius_options | split: ','
-%}

{{ 'dealer-locator-hero.css' | asset_url | stylesheet_tag }}

<section
  id="dl-hero-{{ section.id }}"
  class="dl-hero color-{{ section.settings.color_scheme }}"
  data-dl-hero
  data-dl-scope="{{ section.settings.scope | default: 'default' }}"
>
  {%- if section.settings.background_image != blank -%}
    <div class="dl-hero__bg" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          widths: '800, 1200, 1600, 2400',
          sizes: '100vw',
          alt: ''
      }}
    </div>
  {%- endif -%}

  <h1 class="dl-hero__heading">
    {{ section.settings.heading_line_1 }}
    <span class="dl-hero__heading-line-2">{{ section.settings.heading_line_2 }}</span>
  </h1>

  {%- if section.settings.subtitle != blank -%}
    <p class="dl-hero__subtitle">{{ section.settings.subtitle }}</p>
  {%- endif -%}

  <form
    class="dl-hero__search"
    role="search"
    data-dl-search-form
    onsubmit="return false;"
  >
    <div class="dl-hero__field">
      <svg class="dl-hero__field-icon" viewBox="0 0 16 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M8 0C3.589 0 0 3.589 0 8C0 13.5 8 20 8 20C8 20 16 13.5 16 8C16 3.589 12.411 0 8 0ZM8 11C6.343 11 5 9.657 5 8C5 6.343 6.343 5 8 5C9.657 5 11 6.343 11 8C11 9.657 9.657 11 8 11Z" fill="currentColor"/>
      </svg>
      <input
        type="search"
        class="dl-hero__input"
        data-dl-zip-input
        placeholder="{{ section.settings.zip_placeholder | escape }}"
        aria-label="{{ section.settings.zip_placeholder | escape }}"
        autocomplete="postal-code"
      >
    </div>

    <div class="dl-hero__select-wrapper">
      <svg class="dl-hero__field-icon" viewBox="0 0 19 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9.5 0C4.806 0 1 3.806 1 8.5C1 14.5 9.5 20 9.5 20C9.5 20 18 14.5 18 8.5C18 3.806 14.194 0 9.5 0ZM9.5 11.5C7.843 11.5 6.5 10.157 6.5 8.5C6.5 6.843 7.843 5.5 9.5 5.5C11.157 5.5 12.5 6.843 12.5 8.5C12.5 10.157 11.157 11.5 9.5 11.5Z" stroke="currentColor" stroke-width="1.4" fill="none"/>
      </svg>
      <select class="dl-hero__select" data-dl-application-select aria-label="{{ section.settings.application_label | escape }}">
        {%- for opt in radius_list -%}
          {%- assign trimmed = opt | strip -%}
          <option value="{{ trimmed | escape }}">{{ trimmed }}</option>
        {%- endfor -%}
      </select>
      <svg class="dl-hero__select-caret" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <button type="submit" class="dl-hero__submit" data-dl-submit>
      {{ section.settings.submit_label }}
    </button>
  </form>

  {%- if categories.size > 0 -%}
    <div class="dl-hero__categories" role="group" aria-label="{{ section.settings.categories_label | escape }}">
      {%- for block in categories -%}
        <button
          type="button"
          class="dl-hero__category"
          data-dl-category
          data-dl-value="{{ block.settings.value | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.icon != blank -%}
            <span class="dl-hero__category-icon" aria-hidden="true">
              {{ block.settings.icon | image_url: width: 64 | image_tag: alt: '', loading: 'lazy' }}
            </span>
          {%- else -%}
            <svg class="dl-hero__category-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none"/>
              <circle cx="12" cy="12" r="3" fill="currentColor"/>
            </svg>
          {%- endif -%}
          <span>{{ block.settings.label }}</span>
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (() => {
    const root = document.getElementById('dl-hero-{{ section.id }}');
    if (!root) return;

    const scope = root.dataset.dlScope || 'default';
    const zipInput = root.querySelector('[data-dl-zip-input]');
    const appSelect = root.querySelector('[data-dl-application-select]');
    const submitBtn = root.querySelector('[data-dl-submit]');
    const form = root.querySelector('[data-dl-search-form]');
    const categories = root.querySelectorAll('[data-dl-category]');
    let activeCategory = null;

    const broadcast = () => {
      document.dispatchEvent(new CustomEvent('dl:filter-change', {
        detail: {
          scope: scope,
          zip: zipInput ? zipInput.value.trim() : '',
          application: appSelect ? appSelect.value : '',
          category: activeCategory
        }
      }));
    };

    const setActiveCategory = (value) => {
      const lower = (value || '').toLowerCase();
      activeCategory = (activeCategory === lower) ? null : lower;
      categories.forEach((c) => {
        const v = (c.dataset.dlValue || '').toLowerCase();
        c.classList.toggle('dl-hero__category--active', activeCategory === v);
      });
      broadcast();
    };

    categories.forEach((btn) => {
      btn.addEventListener('click', () => setActiveCategory(btn.dataset.dlValue));
    });

    if (appSelect) appSelect.addEventListener('change', broadcast);

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        broadcast();
      });
    }
    if (submitBtn) {
      submitBtn.addEventListener('click', (e) => {
        e.preventDefault();
        broadcast();
      });
    }

    requestAnimationFrame(broadcast);
  })();
</script>

{% schema %}
{
  "name": "Dealer locator hero",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "scope",
      "label": "Scope ID",
      "info": "Must match the Scope ID on the dealer results section.",
      "default": "default"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Find a Dynamat"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (highlighted)",
      "default": "Dealer Near You"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "3,000+ locations across the US and 30+ countries worldwide. Professional installation for ultimate acoustic performance."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background map image"
    },
    {
      "type": "header",
      "content": "Search form"
    },
    {
      "type": "text",
      "id": "zip_placeholder",
      "label": "ZIP/city placeholder",
      "default": "Enter Zip or City"
    },
    {
      "type": "text",
      "id": "application_label",
      "label": "Application label",
      "default": "Application"
    },
    {
      "type": "text",
      "id": "radius_options",
      "label": "Application options (comma-separated)",
      "default": "All Applications,Car Audio,Automotive Restoration,Home/Architectural,International"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Find Dealership"
    },
    {
      "type": "header",
      "content": "Categories"
    },
    {
      "type": "text",
      "id": "categories_label",
      "label": "Categories aria label",
      "default": "Dealer categories"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "CAR AUDIO"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Filter value",
          "info": "Used to match dealers with the same Category value.",
          "default": "Car Audio"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dealer locator hero",
      "blocks": [
        { "type": "category", "settings": { "label": "CAR AUDIO", "value": "Car Audio" } },
        { "type": "category", "settings": { "label": "AUTOMOTIVE RESTORATION", "value": "Automotive Restoration" } },
        { "type": "category", "settings": { "label": "HOME/ARCHITECTURAL", "value": "Home/Architectural" } },
        { "type": "category", "settings": { "label": "INTERNATIONAL", "value": "International" } }
      ]
    }
  ]
}
{% endschema %}
