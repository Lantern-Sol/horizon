{%- liquid
  assign per_page = section.settings.dealers_per_page | default: 6
  assign dealers = shop.metaobjects.dealers_data.values
  assign total = dealers.size
  assign tile_url = section.settings.tile_url | default: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png'
  assign tile_attribution = section.settings.tile_attribution | default: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
-%}

{{ 'dealer-locator-results.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" crossorigin="">
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" crossorigin="">

<section
  id="dl-results-{{ section.id }}"
  class="dl-results"
  data-dl-results
  data-dl-scope="{{ section.settings.scope | default: 'default' }}"
  data-dl-per-page="{{ per_page }}"
  data-dl-default-lat="{{ section.settings.default_lat }}"
  data-dl-default-lng="{{ section.settings.default_lng }}"
  data-dl-default-zoom="{{ section.settings.default_zoom }}"
  data-dl-tile-url="{{ tile_url | escape }}"
  data-dl-tile-attribution="{{ tile_attribution | escape }}"
  data-dl-default-location="{{ section.settings.default_location | escape }}"
  data-dl-location-prefix="{{ section.settings.location_prefix | escape }}"
  data-dl-empty-label="{{ section.settings.empty_label | escape }}"
>
  <span id="dl-results-anchor" class="dl-results__anchor" aria-hidden="true"></span>

  <script type="application/json" data-dl-data>[
    {%- for dealer in dealers -%}
      {%- unless forloop.first %},{% endunless -%}
      {
        "id": {{ dealer.system.handle | default: forloop.index | append: '' | json }},
        "name": {{ dealer.name | append: '' | json }},
        "address": {{ dealer.address | append: '' | json }},
        "address2": {{ dealer.address_2 | append: '' | json }},
        "city": {{ dealer.city | append: '' | json }},
        "state": {{ dealer.state | append: '' | json }},
        "zipCode": {{ dealer.zip_code | append: '' | json }},
        "country": {{ dealer.country | append: '' | json }},
        "lat": {% if dealer.lat != blank %}{{ dealer.lat }}{% else %}null{% endif %},
        "lng": {% if dealer.long != blank %}{{ dealer.long }}{% else %}null{% endif %},
        "phone": {{ dealer.phone | append: '' | json }},
        "email": {{ dealer.email | append: '' | json }},
        "website": {{ dealer.website | append: '' | json }},
        "description": {{ dealer.description | append: '' | json }},
        "applicationType": {{ dealer.application_type | append: '' | json }}
      }
    {%- endfor -%}
  ]</script>

  <div class="dl-results__inner">
    <header class="dl-results__head">
      <h2 class="dl-results__title">
        <span class="dl-results__count" data-dl-count>{{ total }}</span>
        {{ section.settings.found_label }}
      </h2>
      <p class="dl-results__location" data-dl-location>
        {{ section.settings.location_prefix }} {{ section.settings.default_location }}
      </p>
    </header>

    <div class="dl-results__grid">
      <div class="dl-results__list" data-dl-list aria-live="polite">
        {%- if total == 0 -%}
          <p class="dl-results__empty">{{ section.settings.empty_label }}</p>
        {%- endif -%}
      </div>

      <div class="dl-results__map-wrap">
        <div
          class="dl-results__map"
          data-dl-map
          role="region"
          aria-label="Dealer locations map"
        ></div>
        <div class="dl-results__map-controls" aria-hidden="true">
          <button type="button" class="dl-results__map-btn" data-dl-zoom-in aria-label="Zoom in">
            <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7 1V13M1 7H13" stroke="#09274C" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <button type="button" class="dl-results__map-btn" data-dl-zoom-out aria-label="Zoom out">
            <svg viewBox="0 0 14 2" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1H13" stroke="#09274C" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    {%- if section.settings.show_load_more -%}
      <div class="dl-results__pagination">
        <button
          type="button"
          class="dl-results__more"
          data-dl-more
          data-dl-more-label="{{ section.settings.load_more_label | escape }}"
          data-dl-less-label="{{ section.settings.show_less_label | escape }}"
          hidden
        >
          {{ section.settings.load_more_label }}
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" defer></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js" crossorigin="" defer></script>
<script>
  (() => {
    const root = document.getElementById('dl-results-{{ section.id }}');
    if (!root) return;

    const scope = root.dataset.dlScope || 'default';
    const perPage = parseInt(root.dataset.dlPerPage || '6', 10) || 6;
    const list = root.querySelector('[data-dl-list]');
    const moreBtn = root.querySelector('[data-dl-more]');
    const countEl = root.querySelector('[data-dl-count]');
    const locationEl = root.querySelector('[data-dl-location]');
    const mapEl = root.querySelector('[data-dl-map]');
    const zoomInBtn = root.querySelector('[data-dl-zoom-in]');
    const zoomOutBtn = root.querySelector('[data-dl-zoom-out]');
    const dataEl = root.querySelector('[data-dl-data]');

    const emptyLabel = root.dataset.dlEmptyLabel || 'No dealers found.';
    const locationPrefix = root.dataset.dlLocationPrefix || 'Results near';
    const defaultLocation = root.dataset.dlDefaultLocation || '';

    const dealers = (() => {
      try {
        const raw = (dataEl && dataEl.textContent || '[]').trim();
        return JSON.parse(raw) || [];
      } catch (e) {
        console.warn('Dealer locator: failed to parse data', e);
        return [];
      }
    })();

    let expanded = false;
    let filterApplication = 'All Applications';
    let filterQuery = '';
    let userPoint = null;

    const escapeHtml = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[c]);

    const distanceMiles = (a, b) => {
      const R = 3958.8;
      const toRad = (d) => d * Math.PI / 180;
      const dLat = toRad(b.lat - a.lat);
      const dLng = toRad(b.lng - a.lng);
      const lat1 = toRad(a.lat);
      const lat2 = toRad(b.lat);
      const x = Math.sin(dLat / 2) ** 2 + Math.sin(dLng / 2) ** 2 * Math.cos(lat1) * Math.cos(lat2);
      return R * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1 - x));
    };

    const formatAddress = (d) => {
      const cityLine = [d.city, d.state, d.zipCode].filter(Boolean).join(', ').replace(/, ([^,]+)$/, ' $1');
      return [d.address, d.address2, cityLine, d.country].filter(Boolean).join(', ').replace(/\s+/g, ' ').trim();
    };

    const cardHTML = (d) => {
      const addr = formatAddress(d);
      const dist = (d._distance != null) ? `<span class="dl-card__distance">${d._distance.toFixed(1)} MI</span>` : '';
      const directionsUrl = `https://maps.google.com/?q=${encodeURIComponent(addr || d.name)}`;
      const website = d.website && d.website.trim() ? d.website.trim() : '';
      const websiteHref = website && !/^https?:\/\//i.test(website) ? `https://${website}` : website;

      return `
        <article class="dl-card" data-dl-card data-dl-id="${escapeHtml(d.id)}">
          <header class="dl-card__head">
            <h3 class="dl-card__name">${escapeHtml(d.name)}</h3>
            ${dist}
          </header>
          <div class="dl-card__body">
            ${d.applicationType ? `<p class="dl-card__category">${escapeHtml(d.applicationType)}</p>` : ''}
            ${addr ? `<p class="dl-card__address">${escapeHtml(addr)}</p>` : ''}
          </div>
          <footer class="dl-card__foot">
            <a class="dl-card__link dl-card__link--directions" href="${escapeHtml(directionsUrl)}" target="_blank" rel="noopener">
              <span>Get Directions</span>
              <svg class="dl-card__link-arrow" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2 8L8 2M8 2H3M8 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            ${website ? `<span class="dl-card__sep" aria-hidden="true">|</span>` : ''}
            ${website ? `<a class="dl-card__link dl-card__link--website" href="${escapeHtml(websiteHref)}" target="_blank" rel="noopener">Visit Website</a>` : ''}
          </footer>
        </article>
      `;
    };

    const tipHTML = (d) => {
      const dist = (d._distance != null) ? `<span class="dl-tip__dist">${d._distance.toFixed(1)} MI</span>` : '';
      return `
        <div class="dl-tip">
          <div class="dl-tip__head">
            <span class="dl-tip__name">${escapeHtml(d.name)}</span>
            ${dist}
          </div>
          ${formatAddress(d) ? `<div class="dl-tip__addr">${escapeHtml(formatAddress(d))}</div>` : ''}
        </div>
      `;
    };

    const normalizeZip = (z) => {
      if (z == null) return '';
      const s = String(z).trim();
      const m = s.match(/^(\d{5})/);
      return m ? m[1] : s;
    };

    const addDistance = (list) => list
      .filter((d) => isFinite(d.lat) && isFinite(d.lng))
      .map((d) => ({ ...d, _distance: distanceMiles(userPoint, { lat: d.lat, lng: d.lng }) }))
      .sort((a, b) => a._distance - b._distance);

    const applyFilters = () => {
      // Step 1: filter by application (always applies)
      let result = dealers.filter((d) => {
        if (filterApplication && filterApplication !== 'All Applications') {
          if ((d.applicationType || '').trim().toLowerCase() !== filterApplication.toLowerCase()) return false;
        }
        return true;
      });

      // Step 2: handle search query
      if (!filterQuery) {
        return result.map((d) => ({ ...d, _distance: null }));
      }

      if (isUsZip(filterQuery)) {
        // Strict ZIP match: dealers must have this exact ZIP (first 5 digits compared)
        const targetZip = normalizeZip(filterQuery);
        result = result.filter((d) => normalizeZip(d.zipCode) === targetZip);
        return userPoint ? addDistance(result) : result.map((d) => ({ ...d, _distance: null }));
      }

      if (userPoint) {
        // City / free-text that geocoded: sort all matches by distance
        return addDistance(result);
      }

      // Geocoding failed: plain text match against address fields
      const q = filterQuery.toLowerCase();
      return result
        .filter((d) => {
          const hay = [d.name, d.address, d.address2, d.city, d.state, d.zipCode, d.country, d.applicationType]
            .filter(Boolean).join(' ').toLowerCase();
          return hay.includes(q);
        })
        .map((d) => ({ ...d, _distance: null }));
    };

    const render = () => {
      const filtered = applyFilters();
      const limit = expanded ? filtered.length : Math.min(perPage, filtered.length);
      const visible = filtered.slice(0, limit);

      if (visible.length === 0) {
        list.innerHTML = `<p class="dl-results__empty">${escapeHtml(emptyLabel)}</p>`;
      } else {
        list.innerHTML = visible.map(cardHTML).join('');
      }

      if (countEl) countEl.textContent = filtered.length;
      if (moreBtn) {
        moreBtn.hidden = filtered.length <= perPage;
        moreBtn.textContent = expanded
          ? (moreBtn.dataset.dlLessLabel || 'Show less')
          : (moreBtn.dataset.dlMoreLabel || 'Load more stores');
      }
      updateMap(filtered);
    };

    if (moreBtn) {
      moreBtn.addEventListener('click', () => { expanded = !expanded; render(); });
    }

    // Geocoding via Nominatim (OpenStreetMap). Free; subject to fair-use rate limits.
    const geocodeCache = {};
    const isUsZip = (q) => /^\d{5}(-\d{4})?$/.test(q.trim());
    const isUkPostcode = (q) => /^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/i.test(q.trim());

    const buildGeocodeUrl = (q) => {
      const base = 'https://nominatim.openstreetmap.org/search?format=json&addressdetails=0&limit=1';
      if (isUsZip(q)) return `${base}&postalcode=${encodeURIComponent(q.trim())}&country=us`;
      if (isUkPostcode(q)) return `${base}&postalcode=${encodeURIComponent(q.trim())}&country=gb`;
      return `${base}&q=${encodeURIComponent(q)}`;
    };

    const geocode = async (q) => {
      const key = q.trim().toLowerCase();
      if (!key) return null;
      if (geocodeCache[key]) return geocodeCache[key];
      try {
        const r = await fetch(buildGeocodeUrl(q), { headers: { Accept: 'application/json' } });
        if (!r.ok) {
          console.warn('[dealer locator] geocode HTTP', r.status, 'for', q);
          return null;
        }
        const data = await r.json();
        if (data && data.length) {
          const point = { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon), label: data[0].display_name };
          geocodeCache[key] = point;
          console.log('[dealer locator] geocoded', q, '→', point.label, `(${point.lat.toFixed(4)}, ${point.lng.toFixed(4)})`);
          return point;
        }
        console.warn('[dealer locator] no geocode result for', q);
      } catch (e) {
        console.warn('[dealer locator] geocode failed:', e);
      }
      return null;
    };

    document.addEventListener('dl:search-change', async (e) => {
      if (!e.detail || (e.detail.scope || 'default') !== scope) return;
      filterApplication = e.detail.application || 'All Applications';
      const newQuery = e.detail.query || '';
      const queryChanged = newQuery !== filterQuery;
      filterQuery = newQuery;
      expanded = false;

      if (queryChanged) {
        if (filterQuery) {
          const point = await geocode(filterQuery);
          if (point) {
            userPoint = point;
            if (locationEl) locationEl.textContent = `${locationPrefix} ${filterQuery}`;
          } else {
            userPoint = null;
            if (locationEl) locationEl.textContent = `${locationPrefix} ${filterQuery}`;
          }
        } else {
          userPoint = null;
          if (locationEl) locationEl.textContent = `${locationPrefix} ${defaultLocation}`;
        }
      }
      render();
    });

    // Map setup
    let map = null;
    let cluster = null;
    let userMarker = null;

    const initMap = () => {
      if (!mapEl || !window.L || map) return;
      const lat = parseFloat(root.dataset.dlDefaultLat || '39.4');
      const lng = parseFloat(root.dataset.dlDefaultLng || '-84.5');
      const zoom = parseInt(root.dataset.dlDefaultZoom || '5', 10);

      map = L.map(mapEl, {
        zoomControl: false,
        scrollWheelZoom: true,
        wheelDebounceTime: 40
      }).setView([lat, lng], zoom);

      L.tileLayer(root.dataset.dlTileUrl, {
        attribution: root.dataset.dlTileAttribution,
        maxZoom: 19
      }).addTo(map);

      cluster = (window.L && L.markerClusterGroup)
        ? L.markerClusterGroup({
            disableClusteringAtZoom: 11,
            spiderfyOnMaxZoom: false,
            showCoverageOnHover: false,
            iconCreateFunction: (c) => L.divIcon({
              html: `<div class="dl-cluster"><span>${c.getChildCount()}</span></div>`,
              className: 'dl-cluster-icon',
              iconSize: [44, 44]
            })
          })
        : L.layerGroup();
      map.addLayer(cluster);

      if (zoomInBtn) zoomInBtn.addEventListener('click', () => map.zoomIn());
      if (zoomOutBtn) zoomOutBtn.addEventListener('click', () => map.zoomOut());

      requestAnimationFrame(() => map.invalidateSize());
      setTimeout(() => map.invalidateSize(), 250);
      window.addEventListener('resize', () => map.invalidateSize());

      render();
    };

    const updateMap = (filtered) => {
      if (!map || !cluster) return;
      cluster.clearLayers();
      if (userMarker) { map.removeLayer(userMarker); userMarker = null; }

      const points = [];
      filtered.forEach((d) => {
        if (!isFinite(d.lat) || !isFinite(d.lng)) return;
        const icon = L.divIcon({
          className: 'dl-pin',
          html: '<span class="dl-pin__inner">Dynamat</span>',
          iconSize: [76, 28],
          iconAnchor: [38, 28]
        });
        const marker = L.marker([d.lat, d.lng], { icon, riseOnHover: true });
        marker.bindTooltip(tipHTML(d), { direction: 'top', offset: [0, -8], opacity: 1, className: 'dl-tip-wrap' });
        marker.bindPopup(tipHTML(d), { className: 'dl-tip-wrap', offset: [0, -4] });
        cluster.addLayer(marker);
        points.push([d.lat, d.lng]);
      });

      if (userPoint) {
        const userIcon = L.divIcon({
          className: 'dl-userpin',
          html: '<span class="dl-userpin__dot"></span>',
          iconSize: [18, 18],
          iconAnchor: [9, 9]
        });
        userMarker = L.marker([userPoint.lat, userPoint.lng], { icon: userIcon, interactive: false }).addTo(map);
        const all = points.concat([[userPoint.lat, userPoint.lng]]);
        try { map.fitBounds(all, { padding: [40, 40], maxZoom: 11 }); } catch (e) {}
      } else if (points.length > 1) {
        try { map.fitBounds(points, { padding: [40, 40], maxZoom: 10 }); } catch (e) {}
      } else if (points.length === 1) {
        map.setView(points[0], 9);
      }
    };

    const ready = () => {
      if (window.L) initMap();
      else setTimeout(ready, 80);
    };
    ready();

    // Initial render before map is ready (shows top-N immediately)
    render();
  })();
</script>

{% schema %}
{
  "name": "Dealer locator results",
  "class": "section-wrapper dealer-locator-results-wrapper",
  "settings": [
    { "type": "paragraph", "content": "Dealer entries are managed in Settings → Custom data → Metaobjects → Dealers data." },
    { "type": "text", "id": "scope", "label": "Scope ID", "default": "default" },
    { "type": "text", "id": "found_label", "label": "Found label", "default": "Dealers Found" },
    { "type": "text", "id": "location_prefix", "label": "Location prefix", "default": "Results near" },
    { "type": "text", "id": "default_location", "label": "Default location", "default": "Hamilton, OH" },
    { "type": "text", "id": "empty_label", "label": "Empty label", "default": "No dealers found. Try a different ZIP or category." },
    { "type": "checkbox", "id": "show_load_more", "label": "Show load more", "default": true },
    { "type": "range", "id": "dealers_per_page", "label": "Dealers per page", "min": 1, "max": 24, "step": 1, "default": 6 },
    { "type": "text", "id": "load_more_label", "label": "Load more label", "default": "Load more stores" },
    { "type": "text", "id": "show_less_label", "label": "Show less label", "default": "Show less" },
    { "type": "header", "content": "Map" },
    { "type": "text", "id": "default_lat", "label": "Default latitude", "default": "39.4067" },
    { "type": "text", "id": "default_lng", "label": "Default longitude", "default": "-84.5613" },
    { "type": "range", "id": "default_zoom", "label": "Default zoom", "min": 1, "max": 18, "step": 1, "default": 5 },
    { "type": "text", "id": "tile_url", "label": "Tile URL", "default": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png" },
    { "type": "text", "id": "tile_attribution", "label": "Tile attribution" }
  ],
  "presets": [{ "name": "Dealer locator results" }]
}
{% endschema %}
