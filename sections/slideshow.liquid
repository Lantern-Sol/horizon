{% liquid
  assign is_hero = false
  if section.settings.slideshow_style == 'hero'
    assign is_hero = true
  endif
%}

{% if section.blocks.size > 1 %}
  {% if section.settings.display_mode == 'full_frame' or is_hero %}
    {% assign autoplay = section.settings.autoplay %}
  {% else %}
    {% assign autoplay = false %}
  {% endif %}
  {% liquid
    # Hero style: dots sit below the media and no play/pause buttons are shown
    assign controls_autoplay = autoplay
    assign controls_on_media = true
    if is_hero
      assign controls_autoplay = false
      assign controls_on_media = false
    endif
  %}
  {% capture controls %}
    {%- render 'slideshow-controls',
      style: section.settings.slideshow_controls_style,
      autoplay: controls_autoplay,
      item_count: section.blocks.size,
      show_arrows: false,
      arrows_on_media: true,
      controls_on_media: controls_on_media,
      pagination_position: 'center',
      icon_style: section.settings.icons_style,
      custom_icon: section.settings.custom_icon,
      custom_icon_width: section.settings.custom_icon_width,
      show_arrows_desktop: section.settings.show_arrows_desktop,
      show_arrows_mobile: section.settings.show_arrows_mobile,
      arrows_position: section.settings.arrows_position,
      mobile_arrows_position: section.settings.mobile_arrows_position
    -%}
  {% endcapture %}
{% endif %}

{% capture slides %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign section_width_class = ''
  if is_hero
    assign section_width_class = 'section--full-width slideshow-section--hero'
  elsif section.settings.display_mode == 'with_hints'
    assign section_width_class = 'section--page-width'
    if section.settings.full_frame_on_mobile
      assign section_width_class = section_width_class | append: ' section--mobile-full-width'
    endif
  else
    assign section_width_class = 'section--' | append: section.settings.section_width
  endif

  assign slideshow_class = 'slideshow--content-' | append: section.settings.content_position
  if section.blocks.size == 1
    assign slideshow_class = slideshow_class | append: ' slideshow--single-media'
  endif
  if is_hero
    assign slideshow_class = slideshow_class | append: ' slideshow--hero'
  elsif section.settings.display_mode == 'with_hints'
    assign slideshow_class = slideshow_class | append: ' slideshow--with-hints'
    if section.settings.full_frame_on_mobile
      assign slideshow_class = slideshow_class | append: ' slideshow--with-hints--mobile-full-frame'
    else
      assign slideshow_class = slideshow_class | append: ' slideshow--with-hints--mobile-with-hints'
    endif
  endif

  assign slide_size = section.settings.slide_height
  if is_hero
    # Hero slides control their own height via --hero-slide-height
    assign slide_size = nil
  endif

  assign show_arrows = true
  if section.settings.icons_style == 'none' or section.blocks.size <= 1
    assign show_arrows = false
  endif

  assign rounded_slide_corners = false
  if section.settings.display_mode == 'full_frame' and section.settings.section_width == 'page-width'
    assign rounded_slide_corners = true
  elsif section.settings.display_mode == 'with_hints' and section.settings.full_frame_on_mobile == false
    assign rounded_slide_corners = true
  endif
%}

{% liquid
  if section.settings.background_color != blank
    assign skip_section_contrast = false
    if section.settings.content_position == 'on-media'
      assign skip_section_contrast = true
    endif
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: skip_section_contrast
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="slideshow-section spacing-style section {{ section_width_class }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} disable-section-top-offset"
  style="{% render 'spacing-padding', settings: section.settings %}; --slideshow-gap: {{ section.settings.slideshow_gap }}px;{% if rounded_slide_corners %} --corner-radius: {{ section.settings.corner_radius }}px;{% endif %}{% if is_hero %} --hero-slide-height: {{ section.settings.hero_slide_height }}px; --hero-slide-height-mobile: {{ section.settings.hero_slide_height_mobile }}px; --hero-slide-radius: 24px; --hero-slide-radius-mobile: 18px; --hero-slide-padding: 48px; --hero-slide-padding-mobile: 40px 32px; --hero-slide-margin: {{ section.settings.hero_slide_margin }}px; --hero-slide-margin-mobile: 0px; --hero-slide-gap: {{ section.settings.hero_slide_gap }}px; --hero-slide-gap-mobile: 16px;{% endif %}"
>
  <h2 class="visually-hidden">{{ 'accessibility.slideshow' | t }}</h2>
  {% render 'slideshow',
    class: slideshow_class,
    controls: controls,
    show_arrows: show_arrows,
    icon_style: section.settings.icons_style,
    icon_shape: section.settings.icons_shape,
    autoplay: autoplay,
    autoplay_speed: section.settings.autoplay_speed,
    slides: slides,
    slide_count: section.blocks.size,
    slide_size: slide_size,
    custom_icon: section.settings.custom_icon,
    custom_icon_width: section.settings.custom_icon_width,
    slides_to_show: section.settings.slides_to_show,
    mobile_slides_to_show: section.settings.mobile_slides_to_show,
    slides_to_scroll: section.settings.slides_to_scroll,
    mobile_slides_to_scroll: section.settings.mobile_slides_to_scroll
  %}
</div>

{% stylesheet %}
  .slideshow-section {
    slideshow-arrows .slideshow-control:first-of-type {
      margin-inline-start: var(--padding-xs);
    }

    slideshow-arrows .slideshow-control:last-of-type {
      margin-inline-end: var(--padding-xs);
    }

    .slideshow--with-hints--mobile-with-hints {
      gap: var(--slideshow-gap, 0);
      grid-column: 1 / -1;
    }

    /* Hide navigation arrows at boundaries for with-hints mode */
    .slideshow--with-hints--mobile-with-hints slideshow-arrows .slideshow-control {
      transition: opacity 0.3s ease;
    }

    /* Override animation for boundary arrows in with-hints mode on hover */
    slideshow-component.slideshow--with-hints--mobile-with-hints:has(
        slideshow-slide:first-child:not([aria-hidden='true'])
      )
      > slideshow-container
      > slideshow-arrows
      .slideshow-control--previous,
    slideshow-component.slideshow--with-hints--mobile-with-hints:has(
        slideshow-slide:last-child:not([aria-hidden='true'])
      )
      > slideshow-container
      > slideshow-arrows
      .slideshow-control--next {
      animation: none;
      opacity: 0;
      pointer-events: none;
    }

    @media screen and (max-width: 749px) {
      .slideshow--with-hints--mobile-with-hints slideshow-slides {
        padding-inline: var(--page-margin);
      }

      .slideshow--with-hints--mobile-with-hints slideshow-slide {
        width: 96%;
      }

      .slideshow--with-hints--mobile-with-hints slideshow-slides {
        gap: min(var(--slideshow-gap, 0), 10px);
      }
    }

    /*
     * Hero style — Figma "Section/Hero" (169:314 desktop / 191:305 mobile).
     * Centered slide with neighbors peeking, teal pagination dots below.
     */
    &.slideshow-section--hero {
      background-color: var(--color-background);

      .slideshow--hero {
        grid-column: 1 / -1;
        gap: 24px;

        @media screen and (min-width: 750px) {
          gap: 32px;
        }
      }

      .slideshow--hero slideshow-slides {
        padding-inline: calc(var(--hero-slide-margin-mobile) + var(--hero-slide-gap-mobile));
        scroll-padding-inline: calc(var(--hero-slide-margin-mobile) + var(--hero-slide-gap-mobile));
        gap: var(--hero-slide-gap-mobile);

        @media screen and (min-width: 750px) {
          padding-inline: calc(var(--hero-slide-margin) + var(--hero-slide-gap));
          scroll-padding-inline: calc(var(--hero-slide-margin) + var(--hero-slide-gap));
          gap: var(--hero-slide-gap);
        }
      }

      .slideshow--hero slideshow-slide {
        width: calc(100vw - (var(--hero-slide-margin-mobile) + var(--hero-slide-gap-mobile)) * 2);
        border-radius: var(--hero-slide-radius-mobile);

        @media screen and (min-width: 750px) {
          width: calc(100vw - (var(--hero-slide-margin) + var(--hero-slide-gap)) * 2);
          border-radius: var(--hero-slide-radius);
        }
      }

      .slideshow--hero.slideshow--single-media slideshow-slides {
        justify-content: center;
        overflow: hidden;
      }

      .slideshow--hero slideshow-controls {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Pagination dots — solid teal-800 active, teal-400 outline otherwise (Figma Scrolls/button) */
      .slideshow--hero .slideshow-controls__dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .slideshow--hero .slideshow-controls__dots > li {
        display: block;
        list-style: none;
      }

      .slideshow--hero .slideshow-controls__dots .slideshow-control {
        width: 12px;
        height: 12px;
        padding: 0;
        border: 1px solid var(--color-teal-400, #5bc5ad);
        border-radius: 50%;
        background-color: transparent;
        font-size: 0;
        line-height: 0;
        color: transparent;
        cursor: pointer;
        transition:
          background-color var(--animation-speed, 0.2s) ease,
          border-color var(--animation-speed, 0.2s) ease;
      }

      .slideshow--hero .slideshow-controls__dots .slideshow-control[aria-selected='true'] {
        background-color: var(--color-teal-800, #064c4d);
        border-color: var(--color-teal-800, #064c4d);
      }
    }

    @media screen and (min-width: 750px) {
      .slideshow--with-hints {
        gap: var(--slideshow-gap, 0);
        grid-column: 1 / -1;
      }

      .slideshow--with-hints slideshow-slides {
        padding-inline: var(--page-margin);
        gap: var(--slideshow-gap, 0);
      }

      .slideshow--with-hints slideshow-slide {
        width: calc((100vw - var(--page-margin) * 2));
        overflow: hidden;
      }

      .slideshow--with-hints slideshow-arrows .slideshow-control {
        transition: opacity 0.3s ease;
      }

      slideshow-component.slideshow--with-hints:has(slideshow-slide:first-child:not([aria-hidden='true']))
        > slideshow-container
        > slideshow-arrows
        .slideshow-control--previous,
      slideshow-component.slideshow--with-hints:has(slideshow-slide:last-child:not([aria-hidden='true']))
        > slideshow-container
        > slideshow-arrows
        .slideshow-control--next {
        animation: none;
        opacity: 0;
        pointer-events: none;
      }
    }
  }
{% endstylesheet %}

{% schema %}
