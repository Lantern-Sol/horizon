{%- liquid
  # Background and Spacing Settings
  assign bg_image = section.settings.bg_image | image_url: width: 1920
  assign bg_color = section.settings.bg_color | default: '#0d3238'
  assign overlay_color = section.settings.bg_overlay_color | default: '#064c4d'
  assign overlay_opacity = section.settings.bg_overlay_opacity | divided_by: 100.0

  # Colour Wash Settings
  assign wash_start = section.settings.wash_start_color | default: '#064c4d'
  assign wash_start_opacity = section.settings.wash_start_opacity | divided_by: 100.0
  assign wash_end = section.settings.wash_end_color | default: '#6ce4c9'
  assign wash_end_opacity = section.settings.wash_end_opacity | divided_by: 100.0

  # Card Glassmorphism Settings
  assign card_bg = section.settings.card_bg_color | default: '#ffffff'
  assign card_bg_opacity = section.settings.card_bg_opacity | divided_by: 100.0
  assign card_blur = section.settings.card_blur | default: 12
  assign card_border = section.settings.card_border_color | default: '#ffffff'
  assign card_border_opacity = section.settings.card_border_opacity | divided_by: 100.0
  assign text_color = section.settings.text_color | default: '#ffffff'

  # Pill Badge Settings
  assign badge_text = section.settings.badge_text | default: 'REVIEWS'
  assign badge_link = section.settings.badge_link
  assign badge_bg = section.settings.badge_bg_color | default: '#c3f9ec'
  assign badge_bg_opacity = section.settings.badge_bg_opacity | divided_by: 100.0
-%}

<div
  id="ReviewsLogoSlider-{{ section.id }}"
  class="reviews-logo-slider-section{% if bg_image == blank %} reviews-logo-slider-section--flat{% endif %}"
  style="
    --section-bg-color: {{ bg_color }};
    --section-overlay-color: {{ overlay_color }};
    --section-overlay-opacity: {{ overlay_opacity }};
    --wash-start-color: {{ wash_start }};
    --wash-start-opacity: {{ wash_start_opacity }};
    --wash-end-color: {{ wash_end }};
    --wash-end-opacity: {{ wash_end_opacity }};
    --wash-angle: {{ section.settings.wash_angle }}deg;
    --card-bg-color: {{ card_bg }};
    --card-bg-opacity: {{ card_bg_opacity }};
    --card-blur: {{ card_blur }}px;
    --card-border-color: {{ card_border }};
    --card-border-opacity: {{ card_border_opacity }};
    --badge-bg-color: {{ badge_bg }};
    --badge-bg-opacity: {{ badge_bg_opacity }};
    --text-color: {{ text_color }};
    --quote-size: {{ section.settings.quote_font_size }}px;
    --quote-size-mobile: {{ section.settings.quote_font_size_mobile }}px;
    --logo-max-height: {{ section.settings.logo_max_height }}px;
    --logo-gap: {{ section.settings.logo_gap }}px;
    --padding-block-start: {{ section.settings['padding-block-start'] }}px;
    --padding-block-end: {{ section.settings['padding-block-end'] }}px;
    --padding-inline: {{ section.settings['padding-inline'] }}px;
    --padding-block-start-mobile: {{ section.settings['padding-block-start-mobile'] }}px;
    --padding-block-end-mobile: {{ section.settings['padding-block-end-mobile'] }}px;
    --padding-inline-mobile: {{ section.settings['padding-inline-mobile'] }}px;
    {% if bg_image != blank %}
      background-image: url('{{ bg_image }}');
    {% endif %}
  "
>
  <div class="reviews-logo-slider-section__overlay"></div>
  <div class="reviews-logo-slider-section__wash"></div>

  <div class="reviews-logo-slider-section__container">
    {% if section.blocks.size > 0 %}
      <reviews-logo-slider
        class="reviews-logo-slider"
        data-autoplay="{{ section.settings.autoplay }}"
        data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
        data-total-slides="{{ section.blocks.size }}"
      >
        <!-- Glassmorphism Main Card -->
        <div class="reviews-logo-slider__card">
          <!-- Top Linkable Pill Badge -->
          <div class="reviews-logo-slider__badge-wrapper">
            {% if badge_link != blank %}
              <a href="{{ badge_link }}" class="reviews-logo-slider__badge">
                {{ badge_text | escape }}
              </a>
            {% else %}
              <span class="reviews-logo-slider__badge">
                {{ badge_text | escape }}
              </span>
            {% endif %}
          </div>

          <!-- Slides Container (Quotes) -->
          <div class="reviews-logo-slider__slides" ref="slidesContainer">
            {% for block in section.blocks %}
              <div
                class="reviews-logo-slider__slide {% if forloop.first %}is-active{% endif %}"
                data-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.quote != blank %}
                  <blockquote class="reviews-logo-slider__quote">
                    <p class="reviews-logo-slider__quote-text">
                      “{{ block.settings.quote | escape }}”
                    </p>
                  </blockquote>
                {% endif %}

                <!-- Mobile Only: Display Active Logo inside the Card at the bottom -->
                <div class="reviews-logo-slider__mobile-logo">
                  {% if block.settings.logo != blank %}
                    {{ block.settings.logo | image_url: width: 300 | image_tag: class: 'reviews-logo-slider__brand-logo-img', alt: block.settings.brand_name, loading: 'lazy' }}
                  {% else %}
                    <span class="reviews-logo-slider__brand-fallback">{{ block.settings.brand_name | escape }}</span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Desktop Only: Bottom Row of Brand Logos -->
          <div class="reviews-logo-slider__desktop-thumbnails">
            <div class="reviews-logo-slider__thumbnails-row">
              {% for block in section.blocks %}
                <button
                  class="reviews-logo-slider__thumbnail-btn {% if forloop.first %}is-active{% endif %}"
                  data-thumb-index="{{ forloop.index0 }}"
                  type="button"
                  aria-label="Go to review from {{ block.settings.brand_name | escape }}"
                >
                  {% if block.settings.logo != blank %}
                    {{ block.settings.logo | image_url: width: 240 | image_tag: class: 'reviews-logo-slider__thumbnail-img', alt: block.settings.brand_name, loading: 'lazy' }}
                  {% else %}
                    <span class="reviews-logo-slider__thumbnail-fallback">{{ block.settings.brand_name | escape }}</span>
                  {% endif %}
                </button>
              {% endfor %}
            </div>
          </div>
        </div>

        <!-- Mobile Only: Bottom Pagination Dots below the Card -->
        {% if section.blocks.size > 1 %}
          <div class="reviews-logo-slider__mobile-pagination">
            <div class="reviews-logo-slider__dots" ref="dotsContainer">
              {% for block in section.blocks %}
                <button
                  class="reviews-logo-slider__dot {% if forloop.first %}is-active{% endif %}"
                  data-dot-index="{{ forloop.index0 }}"
                  type="button"
                  aria-label="Go to review {{ forloop.index }}"
                ></button>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </reviews-logo-slider>
    {% else %}
      <div class="reviews-logo-slider-section__empty text-center">
        <p>Please add review blocks to showcase customer testimonials.</p>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .reviews-logo-slider-section {
    position: relative;
    background-color: var(--section-bg-color);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    padding-block-start: var(--padding-block-start, 120px);
    padding-block-end: var(--padding-block-end, 120px);
    padding-inline: var(--padding-inline, 80px);
    overflow: hidden;

    /* The two overlays below blend against the section's own background. Isolating here keeps
       that blending inside the section instead of reaching through to whatever sits behind it. */
    isolation: isolate;
  }

  /* Tint layer: darkens and cools the photo. Multiply is what the design uses, and for a black
     overlay it is indistinguishable from a plain scrim, so existing setups render unchanged. */
  .reviews-logo-slider-section__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--section-overlay-color);
    opacity: var(--section-overlay-opacity, 0);
    mix-blend-mode: multiply;
    z-index: 1;
    pointer-events: none;
  }

  /* Colour wash: recolours the photo towards the brand teal without flattening its luminosity,
     which is what keeps the water texture readable through it. */
  .reviews-logo-slider-section__wash {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      var(--wash-angle, -70deg),
      color-mix(in srgb, var(--wash-start-color) calc(var(--wash-start-opacity) * 100%), transparent) 32.89%,
      color-mix(in srgb, var(--wash-end-color) calc(var(--wash-end-opacity) * 100%), transparent) 119.05%
    );
    mix-blend-mode: color;
    z-index: 1;
    pointer-events: none;
  }

  /* Both blend modes describe how the colour reacts to a photograph. With no background image
     there is nothing to react to — multiply just darkens the flat fill and `color` keeps its
     luminosity, so the gradient disappears entirely. Painting them normally instead keeps the
     section on-palette until a texture is uploaded. */
  .reviews-logo-slider-section--flat .reviews-logo-slider-section__overlay,
  .reviews-logo-slider-section--flat .reviews-logo-slider-section__wash {
    mix-blend-mode: normal;
  }

  .reviews-logo-slider-section__container {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin-inline: auto;
  }

  .reviews-logo-slider {
    display: block;
    width: 100%;
  }

  /* Frosted Glass Card */
  .reviews-logo-slider__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    border: 1px solid color-mix(in srgb, var(--card-border-color) calc(var(--card-border-opacity) * 100%), transparent);
    background: color-mix(in srgb, var(--card-bg-color) calc(var(--card-bg-opacity) * 100%), transparent);
    backdrop-filter: blur(var(--card-blur, 12px));
    -webkit-backdrop-filter: blur(var(--card-blur, 12px));
    border-radius: 30px;
    padding: 96px 20px;
    text-align: center;
    width: 100%;
  }

  /* Top Pill Badge (Linkable) */
  .reviews-logo-slider__badge-wrapper {
    display: flex;
    justify-content: center;
  }

  .reviews-logo-slider__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 132px;
    height: 32px;
    border: 0.5px solid #ffffff;
    background-color: color-mix(in srgb, var(--badge-bg-color) calc(var(--badge-bg-opacity) * 100%), transparent);
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    padding: 6px 14px;
    border-radius: 40px;
    text-decoration: none;
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;

    /* Letter-spacing also trails the final character, which drags the word off-centre by half a
       space. Indenting by one space's worth puts it back where the design has it. */
    text-indent: 0.3em;
  }

  a.reviews-logo-slider__badge:hover {
    background-color: color-mix(in srgb, var(--badge-bg-color) calc(var(--badge-bg-opacity) * 200%), transparent);
    transform: translateY(-1px);
  }

  /* Slides — stacked in one grid cell so the card keeps the height of the longest quote and
     does not jump as slides rotate. */
  .reviews-logo-slider__slides {
    position: relative;
    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: auto;
    width: 100%;
  }

  .reviews-logo-slider__slide {
    grid-column: 1;
    grid-row: 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.4s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .reviews-logo-slider__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    z-index: 3;
  }

  .reviews-logo-slider__quote {
    margin: 0;
    padding: 0;
    max-width: 740px;
  }

  .reviews-logo-slider__quote-text {
    font-size: var(--quote-size, 26px);
    line-height: 1.5;
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
  }

  /* Mobile Active Brand Logo inside Card */
  .reviews-logo-slider__mobile-logo {
    display: none;
    padding-top: 16px;
    align-items: center;
  }

  .reviews-logo-slider__brand-logo-img {
    max-height: var(--logo-max-height, 66px);
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .reviews-logo-slider__brand-fallback {
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Desktop Thumbnails bottom row */
  .reviews-logo-slider__desktop-thumbnails {
    display: block;
    padding-top: 24px;
    width: 100%;
  }

  .reviews-logo-slider__thumbnails-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--logo-gap, 72px);
    flex-wrap: wrap;
  }

  .reviews-logo-slider__thumbnail-btn {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    opacity: 0.3;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    outline: none;
  }

  .reviews-logo-slider__thumbnail-btn:hover {
    opacity: 0.6;
  }

  /* The design sizes each logo to its own artwork rather than to a shared box, so only the
     height is capped and the width follows the aspect ratio. */
  .reviews-logo-slider__thumbnail-btn.is-active {
    opacity: 1;
  }

  .reviews-logo-slider__thumbnail-img {
    max-height: var(--logo-max-height, 66px);
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: brightness(0) invert(1); /* Forces logos to render white just like the screenshot design */
  }

  /* Shown only until a brand logo image is uploaded for the block. */
  .reviews-logo-slider__thumbnail-fallback {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Mobile Dots Navigation */
  .reviews-logo-slider__mobile-pagination {
    display: none;
    justify-content: center;
    margin-top: 24px;
  }

  .reviews-logo-slider__dots {
    display: flex;
    gap: 14px;
  }

  .reviews-logo-slider__dot {
    background: transparent;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.6);
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
    outline: none;
  }

  .reviews-logo-slider__dot.is-active {
    background-color: #ffffff;
    border-color: #ffffff;
  }

  .reviews-logo-slider-section__empty {
    color: var(--text-color);
  }

  /* Responsive Design Adjustments */
  @media screen and (max-width: 749px) {
    .reviews-logo-slider-section {
      padding-block-start: var(--padding-block-start-mobile, 48px);
      padding-block-end: var(--padding-block-end-mobile, 48px);
      padding-inline: var(--padding-inline-mobile, 16px);
    }

    /* Mobile aligns the card's contents to the left rather than centring them. */
    .reviews-logo-slider__card {
      padding: 32px;
      gap: 24px;
      align-items: flex-start;
      text-align: left;
    }

    .reviews-logo-slider__badge-wrapper {
      justify-content: flex-start;
    }

    .reviews-logo-slider__slide {
      align-items: flex-start;
    }

    .reviews-logo-slider__quote-text {
      font-size: var(--quote-size-mobile, 24px);
      line-height: 1.3;
    }

    .reviews-logo-slider__desktop-thumbnails {
      display: none; /* Hide bottom brand row on mobile */
    }

    .reviews-logo-slider__mobile-logo {
      display: flex; /* Show active brand inside the card at the bottom on mobile */
    }

    .reviews-logo-slider__mobile-pagination {
      display: flex; /* Show pagination dots below card on mobile */
    }
  }
</style>

<script>
  /**
   * Custom element <reviews-logo-slider> to handle slide transition logic
   */
  class ReviewsLogoSlider extends HTMLElement {
    constructor() {
      super();
      this.currentSlide = 0;
      this.autoplayTimer = null;
      this.touchStartX = 0;
      this.touchEndX = 0;
    }

    connectedCallback() {
      this.totalSlides = parseInt(this.dataset.totalSlides) || 0;
      this.autoplay = this.dataset.autoplay === 'true';
      this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;

      this.slides = this.querySelectorAll('.reviews-logo-slider__slide');
      this.thumbBtns = this.querySelectorAll('.reviews-logo-slider__thumbnail-btn');
      this.dotBtns = this.querySelectorAll('.reviews-logo-slider__dot');

      if (this.totalSlides <= 1) return;

      // Handle desktop thumbnails interaction
      this.thumbBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.dataset.thumbIndex);
          this.goToSlide(index);
          this.startAutoplay(); // Reset autoplay timer
        });
      });

      // Handle mobile dots interaction
      this.dotBtns.forEach((dot) => {
        dot.addEventListener('click', () => {
          const index = parseInt(dot.dataset.dotIndex);
          this.goToSlide(index);
          this.startAutoplay(); // Reset autoplay timer
        });
      });

      // Swipe gestures for mobile
      this.addEventListener('touchstart', (e) => {
        this.touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      this.addEventListener('touchend', (e) => {
        this.touchEndX = e.changedTouches[0].screenX;
        this.handleSwipe();
      }, { passive: true });

      // Start Autoplay
      this.startAutoplay();

      // Pause autoplay on mouse enter, resume on leave
      this.addEventListener('mouseenter', () => this.stopAutoplay());
      this.addEventListener('mouseleave', () => this.startAutoplay());
    }

    disconnectedCallback() {
      this.stopAutoplay();
    }

    startAutoplay() {
      if (!this.autoplay) return;
      this.stopAutoplay();
      this.autoplayTimer = setInterval(() => {
        this.nextSlide();
      }, this.autoplaySpeed);
    }

    stopAutoplay() {
      if (this.autoplayTimer) {
        clearInterval(this.autoplayTimer);
        this.autoplayTimer = null;
      }
    }

    nextSlide() {
      const nextIndex = (this.currentSlide + 1) % this.totalSlides;
      this.goToSlide(nextIndex);
    }

    prevSlide() {
      const prevIndex = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
      this.goToSlide(prevIndex);
    }

    goToSlide(index) {
      if (index === this.currentSlide || index < 0 || index >= this.totalSlides) return;

      // Deactivate current elements
      this.slides[this.currentSlide].classList.remove('is-active');
      if (this.thumbBtns.length > 0) this.thumbBtns[this.currentSlide].classList.remove('is-active');
      if (this.dotBtns.length > 0) this.dotBtns[this.currentSlide].classList.remove('is-active');

      // Update slide index
      this.currentSlide = index;

      // Activate new elements
      this.slides[this.currentSlide].classList.add('is-active');
      if (this.thumbBtns.length > 0) this.thumbBtns[this.currentSlide].classList.add('is-active');
      if (this.dotBtns.length > 0) this.dotBtns[this.currentSlide].classList.add('is-active');
    }

    handleSwipe() {
      const swipeDistance = this.touchEndX - this.touchStartX;
      const swipeThreshold = 50; // pixels

      if (swipeDistance > swipeThreshold) {
        this.prevSlide();
        this.startAutoplay();
      } else if (swipeDistance < -swipeThreshold) {
        this.nextSlide();
        this.startAutoplay();
      }
    }
  }

  if (!customElements.get('reviews-logo-slider')) {
    customElements.define('reviews-logo-slider', ReviewsLogoSlider);
  }
</script>

{% schema %}
{
  "name": "Reviews Logo Slider",
  "tag": "section",
  "class": "reviews-logo-slider-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Upload a background texture (e.g. water texture)."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0d3238"
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Background Overlay Color",
      "default": "#064c4d"
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "label": "Background Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colour Wash"
    },
    {
      "type": "paragraph",
      "content": "A diagonal gradient laid over the background image. It shifts the photo towards these colours while keeping its light and shade, so the texture stays visible. Set both opacities to 0 to switch it off."
    },
    {
      "type": "color",
      "id": "wash_start_color",
      "label": "Wash Start Color",
      "default": "#064c4d"
    },
    {
      "type": "range",
      "id": "wash_start_opacity",
      "label": "Wash Start Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "color",
      "id": "wash_end_color",
      "label": "Wash End Color",
      "default": "#6ce4c9"
    },
    {
      "type": "range",
      "id": "wash_end_opacity",
      "label": "Wash End Opacity",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "%",
      "default": 32
    },
    {
      "type": "range",
      "id": "wash_angle",
      "label": "Wash Angle",
      "min": -180,
      "max": 180,
      "step": 5,
      "unit": "deg",
      "default": -70
    },
    {
      "type": "header",
      "content": "Pill Badge Settings"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "REVIEWS"
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Badge Link",
      "info": "Makes the top badge clickable to a reviews page."
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge Background Color",
      "default": "#c3f9ec"
    },
    {
      "type": "range",
      "id": "badge_bg_opacity",
      "label": "Badge Background Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Frosted Card Design"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_bg_opacity",
      "label": "Card Background Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_blur",
      "label": "Backdrop Blur Amount",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
