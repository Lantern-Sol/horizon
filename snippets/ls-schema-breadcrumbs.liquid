{% doc %}
  BreadcrumbList structured data (JSON-LD), rendered in <head> via 'ls-seo'
  on every template except the home page, whether or not the visual
  breadcrumbs section is present.

  NOTE: the trail logic intentionally mirrors sections/breadcrumbs.liquid.
  If the trail rules change there, update this snippet to match (and vice
  versa). The product middle crumb uses the global theme setting
  seo_breadcrumb_product_source (auto: category → type → collection).

  Middle crumbs are only emitted when they resolve to a URL; the last item
  carries a name only, per Google's BreadcrumbList guidelines.
{% enddoc %}

{%- liquid
  assign leaf_label = ''
  assign mid_label = ''
  assign mid_url = ''

  case template.name
    when 'collection'
      assign leaf_label = collection.title
    when 'product'
      assign source = settings.seo_breadcrumb_product_source | default: 'auto'

      if source == 'category'
        assign mid_label = product.category.name
      elsif source == 'type'
        assign mid_label = product.type
      elsif source == 'collection'
        assign parent_collection = collection
        if parent_collection.handle == blank
          assign parent_collection = product.collections.first
        endif
        if parent_collection.handle != blank
          assign mid_label = parent_collection.title
          assign mid_url = parent_collection.url
        endif
      else
        if product.category.name != blank
          assign mid_label = product.category.name
        elsif product.type != blank
          assign mid_label = product.type
        else
          assign parent_collection = collection
          if parent_collection.handle == blank
            assign parent_collection = product.collections.first
          endif
          if parent_collection.handle != blank
            assign mid_label = parent_collection.title
            assign mid_url = parent_collection.url
          endif
        endif
      endif

      if mid_label != blank and mid_url == blank
        assign mid_handle = mid_label | handleize
        assign matched_collection = collections[mid_handle]
        if matched_collection.handle != blank
          assign mid_url = matched_collection.url
        endif
      endif

      assign leaf_label = product.title
    when 'blog'
      assign leaf_label = blog.title
    when 'article'
      assign mid_label = blog.title
      assign mid_url = blog.url
      assign leaf_label = article.title
    when 'page'
      assign leaf_label = page.title
    when 'search'
      assign leaf_label = 'content.search' | t
    else
      if page_title != blank and request.page_type != 'index'
        assign leaf_label = page_title
      endif
  endcase

  assign leaf_position = 2
  if mid_label != blank and mid_url != blank
    assign leaf_position = 3
  endif
-%}

{%- if leaf_label != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'content.breadcrumbs_home' | t | json }},
          "item": {{ shop.url | append: routes.root_url | json }}
        },
        {%- if mid_label != blank and mid_url != blank %}
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ mid_label | json }},
          "item": {{ shop.url | append: mid_url | json }}
        },
        {%- endif %}
        {
          "@type": "ListItem",
          "position": {{ leaf_position }},
          "name": {{ leaf_label | json }}
        }
      ]
    }
  </script>
{%- endif -%}
