{%- liquid
  assign block = card_block
-%}
<article
  class="dl-card"
  data-dl-card
  data-dl-name="{{ block.settings.name | escape }}"
  data-dl-category="{{ block.settings.category | escape }}"
  data-dl-address="{{ block.settings.address | escape }}"
  data-dl-distance="{{ block.settings.distance | escape }}"
  data-dl-lat="{{ block.settings.lat | escape }}"
  data-dl-lng="{{ block.settings.lng | escape }}"
  {{ block.shopify_attributes }}
>
  <header class="dl-card__head">
    <h3 class="dl-card__name">{{ block.settings.name | escape }}</h3>
    {%- if block.settings.distance != blank -%}
      <span class="dl-card__distance">{{ block.settings.distance | escape }}</span>
    {%- endif -%}
  </header>

  <div class="dl-card__body">
    {%- if block.settings.category != blank -%}
      <p class="dl-card__category">{{ block.settings.category | escape }}</p>
    {%- endif -%}
    {%- if block.settings.address != blank -%}
      <p class="dl-card__address">{{ block.settings.address | escape }}</p>
    {%- endif -%}
  </div>

  <footer class="dl-card__foot">
    {%- assign directions_url = block.settings.directions_url -%}
    {%- if directions_url == blank -%}
      {%- assign directions_url = 'https://maps.google.com/?q=' | append: block.settings.address | replace: ' ', '+' -%}
    {%- endif -%}
    <a class="dl-card__link dl-card__link--directions" href="{{ directions_url }}" target="_blank" rel="noopener">
      <span>Get Directions</span>
      <svg class="dl-card__link-arrow" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M2 8L8 2M8 2H3M8 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <span class="dl-card__sep" aria-hidden="true">|</span>
    {%- if block.settings.website_url != blank -%}
      <a class="dl-card__link dl-card__link--website" href="{{ block.settings.website_url }}" target="_blank" rel="noopener">Visit Website</a>
    {%- else -%}
      <span class="dl-card__link dl-card__link--website dl-card__link--muted">Visit Website</span>
    {%- endif -%}
  </footer>
</article>
