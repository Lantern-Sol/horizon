{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  <script
    type="module"
    src="{{ 'cart-recommendations.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
    {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {%- comment -%}
              Figma 2001:1015 spells the line count into the heading ("Cart: 1 Item")
              instead of pairing "Cart" with a count badge, and labels the close
              control "Close" on desktop / an X glyph on mobile (2001:2137). Both
              close affordances are rendered and swapped by media query so the
              shared theme-drawer-header snippet stays untouched.
            {%- endcomment -%}
            {% assign cart_drawer_title = 'content.cart_title_with_count' | t: count: cart.item_count %}
            {% capture cart_drawer_close_label %}
              <span class="cart-drawer__close-text">{{ 'actions.close' | t }}</span>
              <span class="cart-drawer__close-glyph svg-wrapper">
                {{- 'icon-nav-close.svg' | inline_asset_content -}}
              </span>
            {% endcapture %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              close_label: cart_drawer_close_label
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="--header-height: 60px;"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                {%- comment -%}
                  "You May Also Like" (Figma 2001:1039 / 2001:2160). Hidden until
                  sections/cart-recommendations.liquid comes back with products, so
                  a store with no recommendation graph shows no empty card.
                {%- endcomment -%}
                <cart-recommendations
                  class="cart-drawer__recommendations"
                  data-url="{{ routes.product_recommendations_url }}"
                  data-section-id="cart-recommendations"
                  data-product-id="{{ cart.items.first.product.id }}"
                  data-intent="related"
                  data-limit="6"
                  hidden
                ></cart-recommendations>

                <div class="cart-drawer__summary">
                  {% render 'cart-drawer-summary', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  /* ================================================================
     Sana 2026 cart panel
     Figma: Sana_nav_dropdown_cart 2001:1012 (desktop)
            Sana_nav_mobile_dropdown_cart 2001:2132 (mobile)
     ================================================================ */

  /* The stock drawer squeezes the page: theme-drawer.liquid puts
     .page-wrapper--drawer-open on the wrapper, and assets/base.css margins the
     content in by the drawer width, which reflows the whole layout (the header
     narrows enough to collapse links into "More"). Figma floats the cart card
     over the page instead, so cancel the squeeze while the cart is the only
     open drawer — filters, chat and the rest still push. */
  body:has(#cart-drawer[open]):not(:has(theme-drawer[open]:not(#cart-drawer))) .page-wrapper--drawer-open {
    margin-right: 0;
  }

  #cart-drawer .theme-drawer__dialog {
    --theme-drawer-width: var(--nav-utility-width);

    /* Floating over the page instead of beside it means the panel now has to
       clear the sticky header, which sits at --layer-menu-drawer (18) while the
       stock drawer only reaches --layer-sticky (8) + its stack order. */
    z-index: calc(var(--layer-temporary) + var(--drawer-stack-order, 0));

    background-color: var(--nav-utility-background);
    border: none;
    border-radius: var(--nav-panel-radius);
    box-shadow: var(--nav-utility-shadow);

    @media screen and (max-width: 749px) {
      border-radius: 0;
      box-shadow: none;
    }
  }

  /* ── Panel scaffolding ─────────────────────────────────────────── */

  #cart-drawer {
    /* Figma 2001:1012 — the panel is a 16px-gap stack inside 32px gutters.
       At the 1440 desktop / 393 mobile anchors 1rem is exactly 16px, so every
       rem below renders as the literal Figma pixel value. */
    --cart-panel-gutter: var(--nav-panel-padding-inline);
    --cart-panel-gap: 1rem; /* 16 */
    --cart-panel-rule: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    --cart-item-media-width: 6.25rem; /* 100 */
    --cart-item-media-ratio: 100 / 117;
    --cart-item-gap: 1.5rem; /* 24 */
    --cart-item-inset: 1.25rem; /* 20 */
    --cart-item-actions-width: 3.875rem; /* 62 */
    --cart-reco-media-width: 6.25rem; /* 100 */
    --cart-reco-media-height: 7.3125rem; /* 117 */
    --cart-reco-gap: 1.5rem; /* 24 */
    --cart-reco-padding: 1.25rem; /* 20 */
    --cart-reco-name-size: 1.125rem; /* 18 */
  }

  #cart-drawer :is(.cart-drawer__content, .cart-drawer__items, .cart-drawer__inner) {
    background-color: transparent;
  }

  /* The summary is sticky, so it needs the panel's own fill to hide the items
     scrolling beneath it rather than the transparent treatment above. */
  #cart-drawer .cart-drawer__summary {
    background-color: var(--nav-utility-background);
  }

  /* The gutter goes on each block, not on the scroller — the sticky summary is
     a child of `.cart-drawer__content`, so padding both would inset it twice
     and squeeze the checkout buttons. Keeping the scroller full-bleed also lets
     the summary's background span the whole panel as items scroll under it. */
  #cart-drawer .cart-drawer__content {
    padding-inline: 0;
  }

  #cart-drawer :is(.cart-drawer__items, .cart-drawer__summary) {
    padding-inline: var(--cart-panel-gutter);
  }

  /* Margin rather than padding, so the divider above the card is inset to the
     gutter instead of running the full width of the panel. */
  #cart-drawer .cart-drawer__recommendations {
    margin-inline: var(--cart-panel-gutter);
  }

  /* ── Header — Figma 2001:1015 / 2001:2133 ──────────────────────── */

  #cart-drawer .theme-drawer__header {
    /* 16 top spacer + 16 stack gap + the row's own 8 of padding. */
    padding-inline: var(--cart-panel-gutter);
    padding-block: 2.5rem 1.5rem;
    background-color: transparent;
    align-items: center;
    border-block-end: var(--cart-panel-rule);
  }

  #cart-drawer .theme-drawer__title,
  #cart-drawer .theme-drawer__close-button--text {
    font-family: var(--font-heading--family);
    font-size: var(--nav-link-size);
    font-weight: var(--nav-link-weight);
    line-height: var(--nav-link-line-height);
    letter-spacing: normal;
    color: var(--color-teal-800);
    margin: 0;
  }

  #cart-drawer .theme-drawer__close-button--text {
    width: auto;
    height: auto;
    min-width: 0;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    cursor: pointer;
  }

  #cart-drawer .theme-drawer__close-button--text:hover {
    color: var(--nav-panel-link-color-hover);
  }

  #cart-drawer .cart-drawer__close-glyph {
    display: none;
    width: 1.6875rem; /* 27 */
    height: 1.25rem; /* 20 */
  }

  #cart-drawer .cart-drawer__close-glyph svg {
    width: 100%;
    height: 100%;
  }

  /* ── Line items — Figma 2001:1019 / 2001:2141 ──────────────────── */

  /* Figma treats the panel as one column, so `.cart-drawer__content` is the
     only scroller. Leaving the stock nested scroller on the item list lets it
     shrink to nothing on short viewports once the summary and the
     recommendations card have taken their space. */
  #cart-drawer :is(.cart-drawer__items, .cart-drawer__recommendations, .cart-drawer__summary) {
    flex: 0 0 auto;
  }

  #cart-drawer .cart-drawer__items {
    padding-block-start: var(--cart-panel-gap);
    overflow: visible;
  }

  #cart-drawer .cart-drawer__items .cart-items,
  #cart-drawer .cart-drawer__items .cart-items__wrapper {
    --cart-items-gap: var(--cart-panel-gap);
  }

  #cart-drawer .cart-drawer__items .cart-items__table-row {
    display: flex;
    align-items: center;
    gap: var(--cart-item-gap);
    flex-wrap: wrap;
    padding-inline: var(--cart-item-inset);
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
  }

  #cart-drawer .cart-drawer__items .cart-items__table-row + .cart-items__table-row {
    padding-block-start: var(--cart-panel-gap);
    margin-block-start: var(--cart-panel-gap);
    border-block-start: var(--cart-panel-rule);
  }

  /* Bundle children belong to the line above them — no rule between the two. */
  #cart-drawer .cart-drawer__items .cart-items__nested-line {
    padding-block-start: 0;
    margin-block-start: var(--gap-sm);
    border-block-start: none;
  }

  #cart-drawer .cart-drawer__items .cart-items__media {
    flex: 0 0 var(--cart-item-media-width);
    width: var(--cart-item-media-width);
  }

  #cart-drawer .cart-drawer__items .cart-items__media-container {
    /* Overrides the inline `--ratio` the cart item sets from theme settings. */
    aspect-ratio: var(--cart-item-media-ratio);
    border-radius: 0.75rem; /* 12 */
  }

  #cart-drawer .cart-drawer__items .cart-items__media-image {
    border-radius: 0.75rem; /* 12 */
  }

  /* The stock drawer row hoists the detail cell's children into the grid with
     `display: contents`; the Figma column is a single stack, so put it back. */
  #cart-drawer .cart-drawer__items .cart-items__details {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem; /* 8 */
    min-width: 0;
    padding-block: 0.5rem; /* 8 */
    color: var(--color-teal-800);
  }

  #cart-drawer .cart-drawer__items .cart-items__details > * + * {
    margin-block-start: 0;
  }

  #cart-drawer .cart-drawer__items .cart-items__details * {
    font-size: 1rem; /* 16 */
    line-height: 1.5;
  }

  #cart-drawer .cart-drawer__items .cart-items__title {
    font-family: var(--font-heading--family);
    font-size: var(--nav-link-size); /* 18 */
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-teal-800);
  }

  #cart-drawer .cart-drawer__items :is(.cart-items__variants-wrapper, .cart-items__unit-price-wrapper) {
    font-size: 1rem;
  }

  /* Figma shows a single price under the variant, so the drawer drops the
     stock line-total column and keeps the per-item price in its place. */
  #cart-drawer .cart-drawer__items .cart-items__price {
    display: none;
  }

  /* ── Quantity + remove — Figma 2001:1027 ───────────────────────── */

  #cart-drawer .cart-drawer__items .cart-items__quantity {
    /* 62 in Figma, but let a three-digit quantity widen the column rather
       than spill the stepper out of it. */
    flex: 0 0 auto;
    min-width: var(--cart-item-actions-width);
    width: auto;
    margin-block-start: 0;
    padding-block: 0.5rem; /* 8 */
    justify-content: center;
  }

  #cart-drawer .cart-drawer__items .cart-items__quantity-controls {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem; /* 8 */
    width: 100%;
  }

  #cart-drawer .cart-drawer__items .cart-items__quantity-controls > .volume-pricing-info {
    margin-inline-start: 0;
  }

  #cart-drawer .cart-drawer__items .quantity-selector-wrapper {
    justify-content: center;
    gap: 0.5rem;
  }

  #cart-drawer .cart-drawer__items .cart-items__error {
    flex: 1 0 100%;
    margin-block-start: 0;
  }

  /* ── Chevron stepper — Figma 2001:1028 / 2001:2150 ─────────────────
     A white 10px-radius pill holding the value beside a stacked up/down
     chevron pair. The markup order stays minus → input → plus for the
     component JS, so the grid puts plus on the top row and minus below.

     These live here rather than in `quantity-selector` because
     assets/base.css loads after the snippet stylesheets — the drawer's id
     selector is what lets the variant win against the base component. */

  #cart-drawer .cart-drawer__items .quantity-selector--chevron {
    --quantity-selector-width: auto;
    --quantity-stepper-chevron-width: 0.375rem; /* 6 */
    --quantity-stepper-chevron-height: 0.6875rem; /* 11 */

    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.875rem; /* 14 */
    row-gap: 0.625rem; /* 10 */
    flex: 0 0 auto;
    align-self: auto;
    width: fit-content;
    height: auto;
    padding-block: 0.625rem; /* 10 */
    padding-inline: 0.875rem; /* 14 */
    background-color: var(--color-white);
    border: none;
    border-radius: 0.625rem; /* 10 */
    color: var(--color-teal-800);
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron input[type='number'] {
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 2ch;
    min-width: 0;
    max-width: none;
    height: auto;
    min-height: 0;
    padding: 0;
    font-family: var(--font-heading--family);
    font-size: var(--nav-link-size); /* 18 */
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
    color: inherit;
    background-color: transparent;
  }

  @supports (field-sizing: content) {
    #cart-drawer .cart-drawer__items .quantity-selector--chevron input[type='number'] {
      field-sizing: content;
      width: auto;
      min-width: 1ch;
    }
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron :is(.quantity-minus, .quantity-plus) {
    position: relative;
    grid-column: 2;
    width: var(--quantity-stepper-chevron-height);
    height: var(--quantity-stepper-chevron-width);
    min-width: 0;
    min-height: 0;
    color: inherit;
    border-radius: 0;
  }

  /* Restore a usable tap target without disturbing the 11 × 6 Figma box. */
  #cart-drawer .cart-drawer__items .quantity-selector--chevron :is(.quantity-minus, .quantity-plus)::after {
    content: '';
    position: absolute;
    inset: -0.5rem -0.625rem;
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron .quantity-plus {
    grid-row: 1;
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron .quantity-minus {
    grid-row: 2;
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron .svg-wrapper {
    display: block;
    width: var(--quantity-stepper-chevron-width);
    height: var(--quantity-stepper-chevron-height);
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron .quantity-plus .svg-wrapper {
    transform: rotate(-90deg);
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron .quantity-minus .svg-wrapper {
    transform: rotate(90deg);
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron .quantity-plus:active .svg-wrapper {
    transform: rotate(-90deg) scale(0.9);
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron .quantity-minus:active .svg-wrapper {
    transform: rotate(90deg) scale(0.9);
  }

  #cart-drawer .cart-drawer__items .quantity-selector--chevron :is(.quantity-minus, .quantity-plus):disabled {
    opacity: var(--opacity-40);
    cursor: default;
  }

  /* ── "You May Also Like" — Figma 2001:1039 / 2001:2160 ─────────── */

  #cart-drawer .cart-drawer__recommendations {
    display: block;
    margin-block-start: var(--cart-panel-gap);
    padding-block-start: var(--cart-panel-gap);
    border-block-start: var(--cart-panel-rule);
  }

  #cart-drawer .cart-drawer__recommendations[hidden] {
    display: none;
  }

  #cart-drawer .cart-reco__card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem; /* 4 */
    padding: var(--cart-reco-padding);
    border-radius: 1rem; /* 16 */
    background-color: var(--nav-utility-field-background);
    color: var(--color-teal-800);
  }

  #cart-drawer .cart-reco__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    padding-block: 0.5rem; /* 8 */
  }

  #cart-drawer .cart-reco__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--nav-link-size); /* 18 */
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: normal;
    color: inherit;
  }

  #cart-drawer .cart-reco__nav {
    display: flex;
    align-items: center;
    gap: 0.625rem; /* 10 */
    flex-shrink: 0;
  }

  #cart-drawer .cart-reco__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.875rem; /* 30 */
    height: 1.875rem;
    padding: 0;
    border: 1px solid var(--color-teal-800);
    border-radius: 5rem; /* 80 */
    background: transparent;
    color: var(--color-teal-800);
    cursor: pointer;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  #cart-drawer .cart-reco__arrow:disabled {
    opacity: var(--opacity-30);
    cursor: default;
  }

  #cart-drawer .cart-reco__arrow-icon {
    display: flex;
    width: 0.75rem; /* 12 */
    height: 0.6875rem; /* 11 */
  }

  #cart-drawer .cart-reco__arrow-icon svg {
    width: 100%;
    height: 100%;
  }

  #cart-drawer .cart-reco__arrow--prev .cart-reco__arrow-icon {
    transform: rotate(180deg);
  }

  #cart-drawer .cart-reco__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  #cart-drawer .cart-reco__track::-webkit-scrollbar {
    display: none;
  }

  #cart-drawer .cart-reco__slide {
    display: flex;
    align-items: center;
    gap: var(--cart-reco-gap);
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
  }

  #cart-drawer .cart-reco__media {
    display: block;
    flex: 0 0 var(--cart-reco-media-width);
    width: var(--cart-reco-media-width);
    height: var(--cart-reco-media-height);
    border-radius: 0.75rem; /* 12 */
    overflow: hidden;
  }

  #cart-drawer .cart-reco__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #cart-drawer .cart-reco__info {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem; /* 8 */
    min-width: 0;
    padding-block: 0.5rem; /* 8 */
  }

  #cart-drawer .cart-reco__name {
    font-family: var(--font-heading--family);
    font-size: var(--cart-reco-name-size);
    font-weight: 600;
    line-height: 1.5;
    color: inherit;
    text-decoration: none;
    overflow-wrap: break-word;
  }

  #cart-drawer .cart-reco__price {
    font-family: var(--font-body--family);
    font-size: 1rem; /* 16 */
    font-weight: 400;
    line-height: 1.5;
  }

  #cart-drawer .cart-reco__view {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem; /* 10 */
    flex-shrink: 0;
    width: auto;
    height: auto;
    min-height: 0;
    padding-block: 0.625rem; /* 10 */
    padding-inline: 1.25rem; /* 20 */
    border: none;
    border-radius: 5rem; /* 80 */
    background-color: var(--color-teal-800);
    color: var(--color-white);
    font-family: var(--font-heading--family);
    font-size: 0.875rem; /* 14 */
    font-weight: 600;
    line-height: normal;
    letter-spacing: var(--letter-spacing--002);
    text-decoration: none;
    box-shadow: none;
  }

  #cart-drawer .cart-reco__view:hover {
    background-color: var(--color-teal-700);
  }

  #cart-drawer .cart-reco__view-icon {
    display: flex;
    width: 0.625rem; /* 10 */
    height: 0.625rem;
    flex-shrink: 0;
  }

  #cart-drawer .cart-reco__view-icon svg {
    width: 100%;
    height: 100%;
  }

  /* ── Footer — Figma 2001:1061 / 2001:1066 ──────────────────────── */

  #cart-drawer .cart-drawer__summary {
    gap: var(--cart-panel-gap);
    padding-block: 0 1.375rem; /* 22 bottom spacer, Figma 2001:1069 */
  }

  #cart-drawer .cart-drawer__summary > .cart-drawer-summary {
    padding-block-start: var(--cart-panel-gap);
    border-block-start: var(--cart-panel-rule);
  }

  /* The stock rules add a second rule above the totals; the panel already
     draws one, so keep it to a single hairline. */
  #cart-drawer .cart-drawer__summary .cart__summary-totals,
  #cart-drawer .cart-drawer__summary .cart-totals {
    border-block-start: none;
    padding-block-start: 0;
  }

  /* ── Mobile — Figma 2001:2131 ──────────────────────────────────── */

  @media screen and (max-width: 749px) {
    #cart-drawer {
      --cart-panel-gutter: var(--nav-bar-padding-mobile); /* 24 */
      --cart-item-media-width: 4.75rem; /* 76 */
      --cart-item-media-ratio: 76 / 89;
      --cart-item-inset: 0;
      --cart-reco-media-width: 4.625rem; /* 74 */
      --cart-reco-media-height: 5.4375rem; /* 87 */
      --cart-reco-gap: 1rem; /* 16 */
      --cart-reco-padding: 0.75rem 0.875rem; /* 12 / 14 */
      --cart-reco-name-size: 1rem; /* 16 */
    }

    #cart-drawer .theme-drawer__header {
      padding-block: 1.5rem 1rem;
    }

    #cart-drawer .cart-drawer__close-text {
      display: none;
    }

    #cart-drawer .cart-drawer__close-glyph {
      display: block;
    }

    #cart-drawer .cart-reco__card {
      gap: 0.75rem; /* 12 */
    }

    #cart-drawer .cart-reco__head {
      padding-block: 0;
    }
  }
{% endstylesheet %}
